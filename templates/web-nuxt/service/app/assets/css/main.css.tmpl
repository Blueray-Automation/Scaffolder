/* Every colour, space, radius and size below is a design token (app/assets/css/tokens.css, generated from .ai/design/tokens.json).
   Use var(--...) here and in components; never a literal value. See .ai/rules/design.md. */
:root {
  color-scheme: light dark;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-fg);
  font-family: var(--font-family-base);
}

main {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: var(--space-lg);
}

.card {
  width: min(var(--size-content), 100%);
  padding: var(--space-xl);
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.card h1 {
  margin: var(--space-xs) 0 var(--space-sm);
  font-size: var(--font-size-xl);
}

.eyebrow {
  margin: 0;
  color: var(--color-accent);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--font-tracking-wide);
  text-transform: uppercase;
}

.muted {
  margin: 0;
  color: var(--color-muted);
}

.card-error h1 {
  color: var(--color-danger);
}
