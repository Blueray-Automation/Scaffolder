import { describe, expect, it } from "vitest";
import { MAX_NAME_LENGTH, greeting } from "~/utils/greeting";

describe("greeting", () => {
  it("greets the world when there is no name", () => {
    expect(greeting()).toBe("Hello, World!");
  });

  it("greets the name it is given", () => {
    expect(greeting("Ada")).toBe("Hello, Ada!");
  });

  it("ignores spaces around the name", () => {
    expect(greeting("  Ada  ")).toBe("Hello, Ada!");
  });

  it("falls back to the world for a blank name", () => {
    expect(greeting("   ")).toBe("Hello, World!");
  });

  it("falls back to the world for an empty parameter in the address", () => {
    expect(greeting(null)).toBe("Hello, World!");
  });

  it("accepts a name of exactly the maximum length", () => {
    const name = "a".repeat(MAX_NAME_LENGTH);

    expect(greeting(name)).toBe(`Hello, ${name}!`);
  });

  it("ignores a name that is too long", () => {
    expect(greeting("a".repeat(MAX_NAME_LENGTH + 1))).toBe("Hello, World!");
  });
});
