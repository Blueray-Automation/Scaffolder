#!/usr/bin/env bash
# Deploy an already-built image tag to an environment. Images are built ONCE by cd.yml and promoted.
#
#   scripts/deploy.sh <environment> <image-tag>      e.g. scripts/deploy.sh staging sha-0a1b2c3d4e5f
#
# The mechanics live in deploy/targets/<target>.sh (current target: <%cdTarget%>); override with DEPLOY_TARGET.
# Rolling back is deploying the previous good tag.
set -euo pipefail

ENVIRONMENT="${1:?usage: scripts/deploy.sh <environment> <image-tag>}"
TAG="${2:?usage: scripts/deploy.sh <environment> <image-tag>}"
TARGET="${DEPLOY_TARGET:-<%cdTarget%>}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_SCRIPT="$ROOT/deploy/targets/$TARGET.sh"
if [[ ! -f "$TARGET_SCRIPT" ]]; then
  echo "unknown deploy target '$TARGET' (expected $TARGET_SCRIPT)" >&2
  exit 2
fi

<%#hasBackend%>
export BACKEND_IMAGE="<%imageBackend%>:${TAG}"
<%/hasBackend%>
<%#hasWeb%>
export WEB_IMAGE="<%imageWeb%>:${TAG}"
<%/hasWeb%>
export ENVIRONMENT TAG ROOT

echo "==> deploying ${TAG} to ${ENVIRONMENT} (target: ${TARGET})"
# shellcheck source=/dev/null
source "$TARGET_SCRIPT"
deploy
echo "==> deploy script finished for ${ENVIRONMENT}"
