import 'package:material_ui/material_ui.dart';

import '../api/hello_client.dart';
import 'hello_card.dart';

/// The first screen: the greeting the backend returns (see `lib/api/hello_client.dart`), with a loading and an
/// error state the user can retry from. It asks the client it is given and never builds one itself.
class HelloPage extends StatefulWidget {
  const HelloPage({required this.title, required this.client, super.key});

  final String title;
  final HelloClient client;

  @override
  State<HelloPage> createState() => _HelloPageState();
}

class _HelloPageState extends State<HelloPage> {
  late Future<Hello> _hello;

  @override
  void initState() {
    super.initState();
    _hello = widget.client.fetchHello();
  }

  void _retry() {
    setState(() {
      _hello = widget.client.fetchHello();
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(widget.title)),
      body: Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: FutureBuilder<Hello>(
            future: _hello,
            builder: (context, snapshot) {
              final error = snapshot.error;
              if (error != null) {
                final detail = error is ApiException
                    ? error.message
                    : 'Something went wrong';
                return HelloCard.error(detail: detail, onRetry: _retry);
              }
              final hello = snapshot.data;
              if (hello == null) return const HelloCard.loading();
              return HelloCard.success(message: hello.message);
            },
          ),
        ),
      ),
    );
  }
}
