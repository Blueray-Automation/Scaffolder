import 'package:material_ui/material_ui.dart';

import 'api/hello_client.dart';
import 'ui/hello_page.dart';

const String appTitle = '<%title%>';
const Color _seed = Color(0xFF3F51B5);

/// The application: a themed [MaterialApp] (light and dark, following the device) around the first screen.
class HelloApp extends StatelessWidget {
  const HelloApp({required this.client, super.key});

  /// How the app reaches the backend. A test passes one backed by a fake HTTP client.
  final HelloClient client;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: appTitle,
      theme: ThemeData(colorScheme: ColorScheme.fromSeed(seedColor: _seed)),
      darkTheme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: _seed,
          brightness: Brightness.dark,
        ),
      ),
      home: HelloPage(title: appTitle, client: client),
    );
  }
}
