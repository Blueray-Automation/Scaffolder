<%#hasBackend%>
import { render, screen } from "@testing-library/react";
import { afterEach, describe, expect, it, vi } from "vitest";
import HomePage from "@/app/page";
import * as api from "@/lib/api";

afterEach(() => {
  vi.restoreAllMocks();
});

describe("HomePage", () => {
  it("renders the greeting fetched from the backend", async () => {
    vi.spyOn(api, "fetchHello").mockResolvedValue({ message: "Hello, World!" });

    render(await HomePage());

    expect(screen.getByRole("heading", { name: "Hello, World!" })).toBeInTheDocument();
  });

  it("renders the error state instead of crashing when the backend is down", async () => {
    vi.spyOn(api, "fetchHello").mockRejectedValue(new api.ApiError(503, "Backend responded with 503"));

    render(await HomePage());

    expect(screen.getByRole("alert")).toHaveTextContent("Backend responded with 503");
  });

  it("handles non-Error rejections", async () => {
    vi.spyOn(api, "fetchHello").mockRejectedValue("nope");

    render(await HomePage());

    expect(screen.getByRole("alert")).toHaveTextContent("Unknown error");
  });
});
<%/hasBackend%>
<%^hasBackend%>
import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import HomePage from "@/app/page";

async function renderPage(name?: string | string[]) {
  render(await HomePage({ searchParams: Promise.resolve(name === undefined ? {} : { name }) }));
}

describe("HomePage", () => {
  it("greets the world when the address has no name", async () => {
    await renderPage();

    expect(screen.getByRole("heading", { name: "Hello, World!" })).toBeInTheDocument();
  });

  it("greets the name in the address", async () => {
    await renderPage("Ada");

    expect(screen.getByRole("heading", { name: "Hello, Ada!" })).toBeInTheDocument();
  });

  it("uses the first name when the address repeats the parameter", async () => {
    await renderPage(["Ada", "Grace"]);

    expect(screen.getByRole("heading", { name: "Hello, Ada!" })).toBeInTheDocument();
  });

  it("ignores a name that is too long", async () => {
    await renderPage("a".repeat(51));

    expect(screen.getByRole("heading", { name: "Hello, World!" })).toBeInTheDocument();
  });
});
<%/hasBackend%>
