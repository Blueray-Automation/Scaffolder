<%#hasBackend%>
import { HelloCard, type HelloCardProps } from "@/components/HelloCard";
import { fetchHello } from "@/lib/api";

// Rendered per request: the greeting comes from the live backend, never from build time.
export const dynamic = "force-dynamic";

async function loadGreeting(): Promise<HelloCardProps> {
  try {
    const hello = await fetchHello();
    return { state: "success", message: hello.message };
  } catch (error) {
    return { state: "error", detail: error instanceof Error ? error.message : "Unknown error" };
  }
}

export default async function HomePage() {
  return <HelloCard {...await loadGreeting()} />;
}
<%/hasBackend%>
<%^hasBackend%>
import { HelloCard } from "@/components/HelloCard";
import { greeting } from "@/lib/greeting";

// Rendered per request: the greeting depends on the ?name= in the address.
export const dynamic = "force-dynamic";

interface HomePageProps {
  searchParams: Promise<{ name?: string | string[] }>;
}

export default async function HomePage({ searchParams }: HomePageProps) {
  const { name } = await searchParams;
  return <HelloCard message={greeting(Array.isArray(name) ? name[0] : name)} />;
}
<%/hasBackend%>
