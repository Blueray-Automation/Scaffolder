EVIDENCE = ROOT / ".ai" / "evidence"
AGENT_LOCAL = ROOT / ".ai" / "agent.local.json"  # this person's own choice of agent; not in git
HANDOFF = "handoff:"  # an agent "command" such as handoff:cursor: a desktop app the person drives, not a program this tool runs
CLAUDE_DESKTOP = "{claude_desktop}"  # stands for the Claude Code that the Claude desktop app keeps for its Code tab

EXIT_OK, EXIT_FAIL, EXIT_HUMAN, EXIT_STUCK, EXIT_INTEGRITY, EXIT_USAGE = 0, 1, 2, 3, 4, 64

EXAMPLE_FEATURE = "FEAT-000"  # the worked example: its code ships with the project, so there is nothing to implement

IS_WINDOWS = os.name == "nt"


def _prepare_console() -> None:
    """Windows: print UTF-8 (the legacy code page cannot encode the symbols this tool prints)
    and switch a real console to virtual-terminal mode so colour codes render."""
    if not IS_WINDOWS:
        return
    for stream in (sys.stdout, sys.stderr):
        with contextlib.suppress(AttributeError, ValueError, OSError):
            stream.reconfigure(encoding="utf-8", errors="replace")
    if sys.stdout.isatty():
        os.system("")  # noqa: S605 (the empty command is the documented way to enable VT mode)


_prepare_console()

ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def ok(t: str) -> str:
    return c(t, "32")


def bad(t: str) -> str:
    return c(t, "31")


def warn(t: str) -> str:
    return c(t, "33")


def dim(t: str) -> str:
    return c(t, "2")


def say(msg: str = "") -> None:
    print(msg, flush=True)


def die(msg: str, code: int = EXIT_USAGE) -> "None":
    print(bad(f"error: {msg}"), file=sys.stderr)
    sys.exit(code)


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        die(f"{CONFIG_PATH.relative_to(ROOT)} not found")
    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def strip_ansi(s: str) -> str:
    return ANSI.sub("", s)


def tail_lines(path: Path, n: int = 80) -> str:
    try:
        lines = strip_ansi(path.read_text(encoding="utf-8", errors="replace")).splitlines()
    except OSError:
        return ""
    return "\n".join(lines[-n:])


def rel(p: Path) -> str:
    """Path relative to the repository, always with forward slashes (the config and git use them on every OS)."""
    try:
        return p.relative_to(ROOT).as_posix()
    except ValueError:
        return str(p)


def describe_platform() -> str:
    name = {"Darwin": "macOS"}.get(platform.system(), platform.system())
    if name == "Linux" and "microsoft" in platform.release().lower():
        name = "Linux (WSL)"
    return f"{name} {platform.release()}"


def quote_arg(arg: str) -> str:
    """Quote one argument for the shell run_shell uses: sh on macOS/Linux, cmd.exe on Windows."""
    return subprocess.list2cmdline([arg]) if IS_WINDOWS else shlex.quote(arg)


def command_program(command: str) -> str:
    """The program a shell command starts with, quotes removed."""
    return shlex.split(command, posix=not IS_WINDOWS)[0].strip('"')


def adapt_command(command: str) -> str:
    """Commands are written for `python3`. Run them with the interpreter that runs this tool: Windows
    has no reliable `python3` (usually the Microsoft Store stub), and elsewhere it is the same interpreter."""
    return re.sub(r"^python3(?=\s)", lambda _m: quote_arg(sys.executable), command)


# --------------------------------------------------------------------------- python interpreter


def parse_version(text: str) -> tuple:
    major, minor = (text.split(".") + ["0"])[:2]
    return int(major), int(minor)


def python_version(path: str) -> tuple | None:
    """(major, minor) an interpreter reports, or None if it cannot be run."""
    try:
        out = subprocess.run(
            [path, "-c", "import sys; print('%d.%d' % sys.version_info[:2])"],
            capture_output=True, encoding="utf-8", errors="replace", timeout=15,
        )
        return parse_version(out.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def windows_launcher_pythons(want: tuple) -> list:
    """Interpreters the Windows `py` launcher knows (python.org installs register there, not as `python3.12`)."""
    if not (IS_WINDOWS and shutil.which("py")):
        return []
    found = []
    for minor in range(want[1], want[1] + 5):
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            out = subprocess.run(
                ["py", f"-{want[0]}.{minor}", "-c", "import sys; print(sys.executable)"],
                capture_output=True, encoding="utf-8", errors="replace", timeout=15,
            )
            if out.returncode == 0 and out.stdout.strip():
                found.append(out.stdout.strip())
    return found


def find_python(minimum: str) -> tuple:
    """Find an interpreter >= `minimum`. Returns (path, version), or (None, newest version found)."""
    want = parse_version(minimum)
    explicit = os.environ.get("SDLC_PYTHON")
    if explicit:  # an explicit choice is never silently replaced by another interpreter
        path = shutil.which(explicit)
        ver = python_version(path) if path else None
        return (path, ver) if ver and ver >= want else (None, ver)
    # the exact configured version first, then newer ones, then the interpreter running this tool, then
    # whatever `python3` / `python` is (on Windows `python3` is often only the Microsoft Store stub, which
    # cannot run and is skipped below)
    paths = [shutil.which(f"python{want[0]}.{m}") for m in range(want[1], want[1] + 5)]
    paths += windows_launcher_pythons(want)
    paths += [sys.executable] + [shutil.which(name) for name in ("python3", "python")]
    newest, seen = None, set()
    for path in paths:
        if not path or path in seen:
            continue
        seen.add(path)
        ver = python_version(path)
        if ver is None:
            continue
        newest = ver if newest is None else max(newest, ver)
        if ver >= want:
            return path, ver
    return None, newest


def install_hints(minimum: str) -> list:
    """How to get a suitable Python, the line for this operating system first."""
    by_os = {
        "macos": f"  macOS (Homebrew):  brew install python@{minimum}",
        "windows": f"  Windows (winget):  winget install -e --id Python.Python.{minimum}",
        "linux": f"  Ubuntu/Debian:     sudo apt install python{minimum} python{minimum}-venv   (not found? use uv)",
    }
    mine = "windows" if IS_WINDOWS else ("macos" if sys.platform == "darwin" else "linux")
    lines = [by_os.pop(mine), *by_os.values()]
    lines += [
        f"  uv (any OS):       uv python install {minimum}",
        f"  pyenv:             pyenv install {minimum} && pyenv local {minimum}",
        "  other:             https://www.python.org/downloads/",
    ]
    if IS_WINDOWS:
        lines.append("Already installed somewhere unusual?  $env:SDLC_PYTHON='C:\\path\\to\\python.exe'; .\\<%sdlcDir%>\\sdlc.cmd setup   (PowerShell)")
    else:
        lines.append("Already installed somewhere unusual?  SDLC_PYTHON=/path/to/python ./<%sdlcDir%>/sdlc setup")
    return lines


def offer_python_install(minimum: str) -> str | None:
    """Offer to install a suitable Python with uv or Homebrew. Runs only with explicit consent:
    a typed 'y' at the prompt, or SDLC_INSTALL_PYTHON=yes. Returns the interpreter path or None."""
    if shutil.which("uv"):
        name, command = "uv", ["uv", "python", "install", minimum]
    elif shutil.which("brew"):
        name, command = "Homebrew", ["brew", "install", f"python@{minimum}"]
    elif IS_WINDOWS and shutil.which("winget"):
        name = "winget"
        command = ["winget", "install", "-e", "--id", f"Python.Python.{minimum}",
                   "--accept-package-agreements", "--accept-source-agreements"]
    else:
        return None
    consent = os.environ.get("SDLC_INSTALL_PYTHON", "").lower() in ("1", "yes", "true")
    if not consent:
        if not sys.stdin.isatty():
            return None
        try:
            answer = input(f"Install Python {minimum} now with {name}  ({' '.join(command)})? [y/N] ")
        except (EOFError, KeyboardInterrupt):
            return None
        consent = answer.strip().lower() in ("y", "yes")
    if not consent:
        return None
    if subprocess.call(command) != 0:
        say(bad(f"{name} could not install Python {minimum}"))
        return None
    if name == "uv":
        found = subprocess.run(["uv", "python", "find", minimum], capture_output=True, encoding="utf-8", errors="replace")
        return found.stdout.strip() or None if found.returncode == 0 else None
    return find_python(minimum)[0]


def resolve_python(minimum: str, what: str, *, interactive: bool) -> str | None:
    """A suitable interpreter, or None after explaining exactly what to do about it."""
    path, ver = find_python(minimum)
    if path:
        return path
    shown = f"{ver[0]}.{ver[1]}" if ver else "none"
    explicit = os.environ.get("SDLC_PYTHON")
    if explicit:
        say(bad(f"SDLC_PYTHON={explicit} is Python {shown} (or not runnable), but {what} needs Python >= {minimum}."))
        say("Point SDLC_PYTHON at a newer interpreter, or unset it so setup can search for one.")
        return None
    say(bad(f"{what} needs Python >= {minimum}, but the newest Python found is {shown}."))
    if interactive:
        installed = offer_python_install(minimum)
        if installed and (v := python_version(installed)) and v >= parse_version(minimum):
            return installed
    say(f"Install Python {minimum}, then run ./<%sdlcDir%>/sdlc setup again:")
    for line in install_hints(minimum):
        say(line)
    return None


# --------------------------------------------------------------------------- processes


def venv_alternatives(path: str) -> list:
    """A virtual environment keeps its executables in .venv/bin on macOS and Linux and in .venv/Scripts on Windows.
    A spec (written by a person or an agent on one OS) that names one is also run where only the other exists."""
    posix = path.replace("\\", "/").rstrip("/")
    for here, there in ((".venv/bin", ".venv/Scripts"), (".venv/Scripts", ".venv/bin")):
        if posix.endswith(here):
            return [path, posix[: -len(here)] + there]
    return [path]


def build_env(extra: dict | None = None, path_prepend: list | None = None) -> dict:
    env = os.environ.copy()
    env.update({k: str(v) for k, v in (extra or {}).items()})
    dirs = [str(ROOT / q) for p in (path_prepend or []) for q in venv_alternatives(p) if (ROOT / q).is_dir()]
    if dirs:
        env["PATH"] = os.pathsep.join(dirs + [env.get("PATH", "")])
    if IS_WINDOWS:
        env.setdefault("PYTHONUTF8", "1")  # Python tools in child processes read and write UTF-8, not the legacy code page
    return env


def venv_python(name: str = ".venv") -> str:
    """The interpreter inside a virtual environment folder, relative to the component directory."""
    return rf"{name}\Scripts\python.exe" if IS_WINDOWS else f"{name}/bin/python"


VENV_PYTHON = venv_python()

# POSIX: each child gets its own session, so the shell AND the server it starts can be signalled together.
GROUP_KWARGS: dict = {} if IS_WINDOWS else {"start_new_session": True}


def kill_group(proc: subprocess.Popen) -> None:
    """Stop a process and everything it started (a shell command is a tree: shell -> server)."""
    if IS_WINDOWS:
        # /T ends the whole tree (cmd.exe -> uvicorn / node), /F forces it; killing only cmd.exe would leave the server holding its port
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"], capture_output=True, timeout=30)
        with contextlib.suppress(subprocess.TimeoutExpired):
            proc.wait(timeout=5)
        return
    try:
        pgid = os.getpgid(proc.pid)
    except (ProcessLookupError, PermissionError, OSError):
        with contextlib.suppress(subprocess.TimeoutExpired):  # already gone
            proc.wait(timeout=5)
        return
    with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
        os.killpg(pgid, signal.SIGTERM)
    # Wait for the WHOLE group, not just the shell: the shell exits at once while the server it started is still
    # shutting down gracefully and holding its port. Reaping the shell (poll) keeps it from lingering as a zombie,
    # which would keep the group alive.
    def group_exists() -> bool:
        proc.poll()
        try:
            os.killpg(pgid, 0)  # signal 0 only asks: does any process of the group still exist?
        except (ProcessLookupError, PermissionError, OSError):
            return False
        return True

    deadline = time.time() + 5
    while group_exists() and time.time() < deadline:
        time.sleep(0.1)
    if group_exists():  # ignored SIGTERM
        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
            os.killpg(pgid, signal.SIGKILL)
        deadline = time.time() + 3
        while group_exists() and time.time() < deadline:
            time.sleep(0.1)
    with contextlib.suppress(subprocess.TimeoutExpired):
        proc.wait(timeout=5)


def run_shell(cmd: str, cwd: Path, log: Path, *, env: dict, timeout: int, stdin_text: str | None = None) -> int:
    """Run a shell command, streaming combined output to `log`. Returns exit code (124 = timeout)."""
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(f"$ {cmd}    (cwd={rel(cwd) or '.'})\n\n")
        fh.flush()
        if IS_WINDOWS:
            env = {"PYTHONUTF8": "1", **env}
        proc = subprocess.Popen(
            cmd,
            shell=True,
            cwd=str(cwd),
            env=env,
            stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
            stdout=fh,
            stderr=subprocess.STDOUT,
            **GROUP_KWARGS,
        )
        try:
            proc.communicate(input=stdin_text.encode() if stdin_text is not None else None, timeout=timeout)
        except subprocess.TimeoutExpired:
            kill_group(proc)
            fh.write(f"\n[sdlc] TIMEOUT after {timeout}s\n")
            return 124
        return proc.returncode


# --------------------------------------------------------------------------- evidence


class Run:
    """One verification pass: logs + results.json + report.md under .ai/evidence/<id>/."""

    def __init__(self, label: str = "") -> None:
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        base = f"{stamp}-{label}" if label else stamp
        self.id, n = base, 1
        while (EVIDENCE / self.id).exists():
            n += 1
            self.id = f"{base}-{n}"
        self.dir = EVIDENCE / self.id
        self.logs = self.dir / "logs"
        self.logs.mkdir(parents=True, exist_ok=True)
        self.started = time.time()
        self.items: list = []
        self.notes: list = []
        self.label = label

    def add(self, item: dict) -> dict:
        self.items.append(item)
        return item

    def required_failures(self) -> list:
        return [i for i in self.items if i["status"] == "fail" and i.get("required", True)]

    def passed(self, strict_skips: bool = False) -> bool:
        if self.required_failures():
            return False
        return not (strict_skips and any(i["status"] == "skip" and not i.get("notApplicable") for i in self.items))

    def finish(self, cfg: dict, specs: list | None = None) -> None:
        data = {
            "id": self.id,
            "label": self.label,
            "finished": datetime.datetime.now().isoformat(timespec="seconds"),
            "seconds": round(time.time() - self.started, 1),
            "git": git_info(),
            "passed": self.passed(cfg.get("facts", {}).get("strictSkips", False)),
            "items": self.items,
            "notes": self.notes,
        }
        (self.dir / "results.json").write_text(json.dumps(data, indent=2), encoding="utf-8")
        (self.dir / "report.md").write_text(render_report(data, specs or []), encoding="utf-8")
        latest = EVIDENCE / "latest"
        if latest.is_symlink() or latest.is_file():
            latest.unlink()
        elif latest.is_dir():
            shutil.rmtree(latest)
        shutil.copytree(self.dir, latest)


def git(*args: str) -> str:
    try:
        out = subprocess.run(["git", *args], cwd=str(ROOT), capture_output=True, encoding="utf-8", errors="replace", timeout=20)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def git_porcelain(*extra: str) -> list:
    """`git status --porcelain` lines exactly as git prints them. (`git()` strips its output, which would eat the leading space of the
    first line: " M file" is a modified file, and its path would be read one character off.)"""
    try:
        out = subprocess.run(["git", "status", "--porcelain", *extra], cwd=str(ROOT), capture_output=True, encoding="utf-8", errors="replace", timeout=20)
        return [ln for ln in out.stdout.splitlines() if ln.strip()] if out.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired):
        return []


def git_info() -> dict:
    return {"sha": git("rev-parse", "--short", "HEAD"), "dirty": bool(git("status", "--porcelain"))}


def render_report(data: dict, specs: list) -> str:
    icon = {"pass": "PASS", "fail": "FAIL", "warn": "WARN", "skip": "SKIP"}
    items = data["items"]
    verdict = "PASSED" if data["passed"] else "FAILED"
    lines = [
        f"# Verification report: {verdict}",
        "",
        f"- Run: `{data['id']}`  ({data['seconds']}s, finished {data['finished']})",
        f"- Git: `{data['git'].get('sha') or 'n/a'}`" + (" (uncommitted changes)" if data["git"].get("dirty") else ""),
        "",
    ]
    gate_items = [x for x in items if x["kind"] == "gate"]
    if gate_items:
        lines += ["## Gates", "", "| Status | Gate | Stage | Time | Log |", "|---|---|---|---|---|"]
    for i in gate_items:
        lines.append(f"| {icon[i['status']]} | `{i['id']}` {i['label']} | {i['stage']} | {i['seconds']}s | `{i.get('log', '')}` |")
    known = [i for i in gate_items if i.get("known")]
    if known:
        lines += ["", "### Known failures (failing before adoption, not regressions)", ""] + [f"- `{i['id']}` {i['label']}" for i in known]
    improved = [i for i in gate_items if i.get("improved")]
    if improved:
        lines += ["", "### Now passing (failed at adoption)", ""] + [f"- `{i['id']}` {i['label']}" for i in improved]
    facts = [x for x in items if x["kind"] == "fact"]
    if facts or specs:
        lines += ["", "## Facts (acceptance criteria -> checks)", ""]
        by_id = {f["id"]: f for f in facts}
        for spec in specs:
            lines.append(f"### {spec['feature']}")
            lines += ["", "| AC | Requirement | Checks | Status |", "|---|---|---|---|"]
            for ac_id, text in spec["acs"].items():
                cs = [by_id[k] for k in by_id if ac_id in by_id[k].get("covers", []) and by_id[k].get("feature") == spec["feature"]]
                if not cs:
                    status = "FAIL (no check)"
                elif any(x["status"] == "fail" for x in cs):
                    status = "FAIL"
                elif all(x["status"] == "skip" for x in cs):
                    status = "SKIP"
                else:
                    status = "PASS"
                names = ", ".join(f"`{x['id'].split(':')[-1]}`" for x in cs) or "-"
                lines.append(f"| {ac_id} | {text[:110].replace('|', '/')} | {names} | {status} |")
            lines.append("")
        lines += ["### Check results", "", "| Status | Check | Detail |", "|---|---|---|"]
        for f in facts:
            lines.append(f"| {icon[f['status']]} | `{f['id']}` {f['label']} | {str(f.get('detail', ''))[:160].replace('|', '/')} |")
    bad_items = [i for i in items if i["status"] == "fail"]
    if bad_items:
        lines += ["", "## Failures", ""]
        for i in bad_items:
            lines += [f"### `{i['id']}` {i['label']}", ""]
            if i.get("detail"):
                lines += [str(i["detail"]), ""]
            if i.get("tail"):
                lines += ["```text", i["tail"], "```", ""]
    if data["notes"]:
        lines += ["", "## Notes", ""] + [f"- {n}" for n in data["notes"]]
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------- gates


def ratchet_config(cfg: dict) -> dict | None:
    """Adopted projects (existing code) are judged by a baseline: what passed on adoption day may not fail. None = strict."""
    r = cfg.get("ratchet") or {}
    return r if r.get("enabled") else None


def load_baseline(cfg: dict) -> dict | None:
    r = ratchet_config(cfg)
    if not r:
        return None
    try:
        data = json.loads((ROOT / r["baseline"]).read_text(encoding="utf-8"))
        return data if isinstance(data.get("gates"), dict) else None
    except (OSError, ValueError, AttributeError):
        return None


def run_gate(gate: dict, run: Run, baseline: dict | None = None) -> dict:
    log = run.logs / f"{gate['id']}.log"
    env = build_env(gate.get("env"), gate.get("pathPrepend"))
    t0 = time.time()
    code = run_shell(adapt_command(gate["cmd"]), ROOT / gate["cwd"], log, env=env, timeout=gate.get("timeoutSeconds", 600))
    status = "pass" if code == 0 else ("fail" if gate.get("required", True) else "warn")
    was = (baseline or {}).get("gates", {}).get(gate["id"])
    known_red = was is not None and not was.get("passed", False)
    if known_red and status == "fail":
        status = "warn"  # failing before adoption: reported, never blocking, and it may not be made worse by pretending it is fine
    item = {
        "kind": "gate",
        "id": gate["id"],
        "label": gate["label"],
        "stage": gate["stage"],
        "required": gate.get("required", True),
        "status": status,
        "exitCode": code,
        "seconds": round(time.time() - t0, 1),
        "log": rel(log),
        "cmd": gate["cmd"],
    }
    if known_red and code != 0:
        item["known"] = True
        item["detail"] = "known: already failing when this project was adopted (baseline), not a regression"
    if known_red and code == 0:
        item["improved"] = True
    if status != "pass":
        item["tail"] = tail_lines(log)
    return run.add(item)


def show(item: dict) -> None:
    mark = {"pass": ok("  PASS"), "fail": bad("  FAIL"), "warn": warn("  WARN"), "skip": dim("  SKIP")}[item["status"]]
    extra = dim(f" ({item['seconds']}s)") if "seconds" in item else ""
    detail = ""
    if item["status"] in ("fail", "skip", "warn") and item.get("detail"):
        detail = dim(f"  {str(item['detail']).splitlines()[0][:110]}")
    say(f"{mark}  {item['id']}  {item['label']}{extra}{detail}")


# --------------------------------------------------------------------------- runtime


class RuntimeFailed(Exception):
    pass


def http_ok(url: str, timeout: float = 2.0) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:  # noqa: S310 (local health probe)
            return 200 <= r.status < 400
    except (urllib.error.URLError, OSError, ValueError):
        return False


class Runtime:
    """Starts the system under test (docker compose or local processes) and tears it down."""

    def __init__(self, cfg: dict, mode: str, run: Run) -> None:
        self.cfg, self.mode, self.run = cfg, mode, run
        self.procs: list = []
        rt = cfg["runtime"]
        self.provides = set(rt["docker"]["provides"] if mode == "docker" else rt["local"]["provides"])

    def __enter__(self) -> "Runtime":
        try:
            if self.mode == "docker":
                self._up_docker()
            elif self.mode == "local":
                self._up_local()
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def _up_docker(self) -> None:
        if not shutil.which("docker"):
            raise RuntimeFailed("docker is not installed (set sdlc.runtime to 'local' or 'none' to proceed without it)")
        spec = self.cfg["runtime"]["docker"]
        log = self.run.logs / "runtime-up.log"
        say(dim("  starting docker compose stack (build + wait for healthy)..."))
        code = run_shell(spec["up"], ROOT, log, env=os.environ.copy(), timeout=1500)
        if code != 0:
            self._save_logs()
            raise RuntimeFailed(f"`{spec['up']}` failed (exit {code})\n{tail_lines(log, 40)}")

    def _up_local(self) -> None:
        for svc in self.cfg["runtime"]["local"]["services"]:
            if http_ok(svc["healthUrl"]):
                raise RuntimeFailed(
                    f"{svc['healthUrl']} already responds: stop whatever uses that port first, "
                    "otherwise the facts would be checked against the wrong process"
                )
            log = self.run.logs / f"runtime-{svc['name']}.log"
            fh = open(log, "w", encoding="utf-8")
            say(dim(f"  starting {svc['name']}: {svc['cmd']}"))
            proc = subprocess.Popen(
                svc["cmd"], shell=True, cwd=str(ROOT / svc["cwd"]),
                env=build_env(svc.get("env"), svc.get("pathPrepend")),
                stdout=fh, stderr=subprocess.STDOUT, **GROUP_KWARGS,
            )
            self.procs.append((svc["name"], proc, fh))
            deadline = time.time() + svc.get("startTimeoutSeconds", 60)
            while time.time() < deadline:
                if proc.poll() is not None:
                    raise RuntimeFailed(f"{svc['name']} exited early (code {proc.returncode})\n{tail_lines(log, 40)}")
                if http_ok(svc["healthUrl"]):
                    break
                time.sleep(0.5)
            else:
                raise RuntimeFailed(f"{svc['name']} did not become healthy at {svc['healthUrl']}\n{tail_lines(log, 40)}")

    def _save_logs(self) -> None:
        spec = self.cfg["runtime"]["docker"]
        run_shell(spec["logs"], ROOT, self.run.logs / "runtime-compose.log", env=os.environ.copy(), timeout=120)

    def __exit__(self, *exc) -> None:
        if self.mode == "docker" and shutil.which("docker"):
            self._save_logs()
            run_shell(self.cfg["runtime"]["docker"]["down"], ROOT, self.run.logs / "runtime-down.log", env=os.environ.copy(), timeout=300)
        for _name, proc, fh in reversed(self.procs):
            kill_group(proc)
            fh.close()
        self.procs = []


