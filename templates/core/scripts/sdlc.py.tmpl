def run_verify(cfg: dict, label: str, args: argparse.Namespace, *, with_facts: bool = True, use_baseline: bool = True) -> tuple:
    baseline = None
    if use_baseline and ratchet_config(cfg):
        baseline = load_baseline(cfg)
        if baseline is None:
            say(bad("No baseline yet: this project was adopted, but nobody has recorded what passes today."))
            say("Run  ./<%sdlcDir%>/sdlc baseline  once (it runs every gate and records the result), commit .ai/baseline.json, then run this again.")
            sys.exit(EXIT_HUMAN)
    run = Run(label)
    fail_fast = cfg["loop"]["failFast"] and not getattr(args, "keep_going", False)
    only = set(getattr(args, "only", None) or [])
    stage_filter = getattr(args, "stage", None)
    specs: list = []
    for stage in cfg["stages"]:
        if stage_filter and stage != stage_filter:
            continue
        say(c(f"\n== {stage} ==", "1"))
        if stage == "facts":
            if not (with_facts and cfg["facts"]["enabled"]):
                say(dim("  (skipped)"))
                continue
            specs = run_facts(cfg, run, args)
        else:
            gates = [g for g in cfg["gates"] if g["stage"] == stage and (not only or g["id"] in only)]
            if not gates:
                say(dim("  (no gates)"))
            for g in gates:
                show(run_gate(g, run, baseline))
        if fail_fast and run.required_failures():
            run.notes.append(f"Stopped after stage '{stage}' (failFast). Later stages did not run.")
            break
    better = [i["id"] for i in run.items if i.get("improved")]
    if better:
        msg = f"These gates failed at the baseline and pass now: {', '.join(better)}. Lock the gain in with `./<%sdlcDir%>/sdlc baseline --tighten`."
        run.notes.append(msg)
        say(ok(f"\n  {msg}"))
    run.finish(cfg, specs)
    return run, specs


def summarize(run: Run, cfg: dict) -> bool:
    good = run.passed(cfg.get("facts", {}).get("strictSkips", False))
    counts = {k: sum(1 for i in run.items if i["status"] == k) for k in ("pass", "fail", "warn", "skip")}
    say("")
    say(f"{ok('VERIFIED') if good else bad('NOT VERIFIED')}  {counts['pass']} passed, {counts['fail']} failed, "
        f"{counts['warn']} warnings, {counts['skip']} skipped  [{rel(run.dir)}/report.md]")
    return good


def snapshot(paths: list) -> dict:
    out: dict = {}
    for p in paths:
        full = ROOT / p
        files = [full] if full.is_file() else sorted(f for f in full.rglob("*") if f.is_file() and "__pycache__" not in f.parts) if full.is_dir() else []
        for f in files:
            out[rel(f)] = hashlib.sha256(f.read_bytes()).hexdigest()
    return out


def changed(before: dict, after: dict) -> list:
    return sorted([f"{k} (modified)" for k in before if k in after and before[k] != after[k]]
                  + [f"{k} (deleted)" for k in before if k not in after]
                  + [f"{k} (added)" for k in after if k not in before])


def fingerprint(run: Run) -> str:
    parts = []
    for i in run.required_failures():
        body = re.sub(r"\d+(\.\d+)?", "N", i.get("tail", "") or i.get("detail", ""))[-1500:]
        parts.append(i["id"] + "|" + body)
    return hashlib.sha256("\n".join(sorted(parts)).encode()).hexdigest()[:16]


def render_prompt(path: str, values: dict) -> str:
    """Fill {{placeholders}} in ONE pass, so text inserted by a value (e.g. a PRD) is never re-expanded."""
    text = (ROOT / path).read_text(encoding="utf-8")
    return re.sub(r"\{\{(\w+)\}\}", lambda m: str(values.get(m.group(1), m.group(0))), text)


def run_agent(cfg: dict, command: str, prompt: str, tag: str, run_dir: Path) -> int:
    prompt_file = run_dir / f"{tag}.prompt.md"
    prompt_file.write_text(prompt, encoding="utf-8")
    if command.startswith(HANDOFF):
        return run_handoff(cfg, command[len(HANDOFF):], prompt_file, tag, run_dir)
    log = run_dir / f"{tag}.agent.log"
    env = os.environ.copy()
    env.update({"SDLC_PROMPT_FILE": str(prompt_file), "SDLC_PHASE": tag})
    command = command.replace("{prompt_file}", rel(prompt_file))  # for agents that take the prompt as an argument, not on stdin
    command = expand_command(command)
    say(dim(f"  running agent: {command}"))
    code = run_shell(command, ROOT, log, env=env, timeout=cfg["agent"]["timeoutSeconds"], stdin_text=prompt)
    say(dim(f"  agent finished (exit {code}); output: {rel(log)}"))
    if code != 0:
        for line in agent_output_tail(log):  # the reason is almost always the last thing the agent printed
            say(warn(f"    agent said: {line}"))
    return code


SIGNED_OUT = re.compile(
    r"not logged in|/login|log ?in (is )?required|please (log|sign) ?in|unauthori[sz]ed|invalid api key|missing api key"
    r"|api key (is )?(not set|missing|invalid)|authentication (failed|required|error)", re.I)


def agent_output_tail(log: Path, lines: int = 4) -> list:
    """The last few lines an agent printed (without the `$ command` header the tool writes first)."""
    kept = [ln.strip() for ln in tail_lines(log, 20).splitlines() if ln.strip() and not ln.startswith("$ ")]
    return [ln if len(ln) <= 200 else ln[:197] + "..." for ln in kept[-lines:]]


# The API answers 404 not_found_error when the model an agent asks for no longer exists. Agent CLIs pick their own
# default model, so an old install keeps asking for a retired one.
MODEL_UNAVAILABLE = re.compile(
    r"not_found_error|invalid model|unknown model"
    r"|model\b[^\n]{0,80}\b(not found|does not exist|not available|not supported|retired|deprecated|no longer)", re.I)


def agent_blocker(run_dir: Path, tag: str, code: int) -> str:
    """Why an agent that failed cannot have done any work, so trying again or validating is pointless:
    "signed_out", "model" (the model it asked for is gone), or "" for any other failure."""
    if code == 0:
        return ""
    said = "\n".join(agent_output_tail(run_dir / f"{tag}.agent.log", 8))
    if SIGNED_OUT.search(said):
        return "signed_out"
    return "model" if MODEL_UNAVAILABLE.search(said) else ""


def agent_install(program: str) -> str:
    """Where `program` is on PATH and its version, e.g. "/usr/local/bin/claude (1.0.51 (Claude Code))"; "" if unknown."""
    exe = find_program(program)
    if not exe:
        return ""
    try:
        done = subprocess.run([exe, "--version"], capture_output=True, encoding="utf-8", errors="replace", timeout=10)
        version = next(iter((done.stdout or done.stderr).strip().splitlines()), "")
    except (OSError, subprocess.SubprocessError):
        version = ""
    return f"{exe} ({version})" if version else exe


def explain_blocker(agent: str, kind: str) -> None:
    try:
        program = command_program(agent)
    except (ValueError, IndexError):
        program = "the agent"
    if kind == "model":
        say(bad("\nThe agent could not use its AI model, so it did nothing: no file was drafted or changed."))
        say("The model it asked for is not available (see 'agent said' above). That almost always means the agent is out of date:")
        say("an old version keeps asking for a model that has since been retired.")
        found = agent_install(program) if program != "the agent" else ""
        if found:
            say(f"The one that ran: {found}")
        if program == CLAUDE_DESKTOP:
            say("Update the Claude desktop app: Claude > Check for Updates... (macOS) or Help > Check for Updates... (Windows). It keeps its own Claude Code up to date.")
        elif program == "claude":
            say("Update it: npm install -g @anthropic-ai/claude-code@latest   (or: claude update)")
            say("Several installs can exist side by side and the first on PATH wins: `which -a claude` (Windows: `where claude`) lists them.")
            if find_claude_desktop():
                say("Or skip the CLI: the Claude desktop app keeps its own, current Claude Code. Use it with  ./<%sdlcDir%>/sdlc agent claude-desktop")
        else:
            say(f"Update `{program}`, or name a model it still serves in its command: ./<%sdlcDir%>/sdlc agent")
        say("Or use another agent: ./<%sdlcDir%>/sdlc agent")
        return
    say(bad("\nThe agent is not signed in, so it did nothing: no file was drafted or changed."))
    if program == CLAUDE_DESKTOP:
        say("Open the Claude desktop app and sign in there, then run this again.")
    else:
        say(f"Run `{program}` once in a terminal and sign in" + (" (type /login)" if program == "claude" else " (or set its API key)") + ", then run this again.")
    say("Or use another agent: ./<%sdlcDir%>/sdlc agent")


def failures_markdown(run: Run) -> str:
    chunks = []
    for i in run.required_failures():
        chunks.append(f"### {i['id']}: {i['label']}\n" + (f"Command: `{i['cmd']}`\n" if i.get("cmd") else "")
                      + f"Result: {i.get('detail') or 'exit ' + str(i.get('exitCode'))}\n"
                      + ("```text\n" + i.get("tail", "") + "\n```" if i.get("tail") else ""))
    return "\n\n".join(chunks)


# --------------------------------------------------------------------------- dependencies and agent


INSTALLED_STATE = EVIDENCE / "installed.json"


def manifest_hash(step: dict) -> str:
    h = hashlib.sha256()
    for m in step.get("manifests", []):
        p = ROOT / m
        h.update(m.encode())
        h.update(p.read_bytes() if p.is_file() else b"<missing>")
    return h.hexdigest()


def load_installed() -> dict:
    try:
        return json.loads(INSTALLED_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_installed(state: dict) -> None:
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    INSTALLED_STATE.write_text(json.dumps(state, indent=2), encoding="utf-8")


def setup_command(step: dict, python: str | None) -> str:
    """The shell command for a setup step, with the OS-specific parts filled in: {python} (an interpreter that
    satisfies the project) and {venv_python} (the project's virtual environment). Plain strings, no shell syntax
    beyond `&&`, so the same step runs in sh, cmd.exe and PowerShell."""
    command = step["cmd"]
    # `npm ci` needs a lockfile; without one fall back to `npm install` (decided here, not with `if [ -f ... ]`, which cmd.exe cannot run)
    if step.get("fallbackCmd") and step.get("lockfile") and not (ROOT / step["cwd"] / step["lockfile"]).exists():
        command = step["fallbackCmd"]
    command = command.replace("{venv_python}", venv_python(step.get("venv", ".venv")))
    if python:
        command = command.replace("{python}", quote_arg(python))
    return command


def run_setup_step(step: dict, run: Run) -> bool:
    """Run one setup step (picking an interpreter for Python steps) and record what was installed."""
    minimum = step.get("minPython")
    python = None
    if minimum:  # pick (or offer to install) an interpreter that satisfies the project, never fail with a raw pip error
        python = resolve_python(minimum, step["label"], interactive=True)
        if python is None:
            return False
        ver = python_version(python) or (0, 0)
        say(dim(f"  using {python} (Python {ver[0]}.{ver[1]})"))
    command = setup_command(step, python)
    say(f"  {step['label']} ...")
    log = run.logs / f"{step['id']}.log"
    code = run_shell(command, ROOT / step["cwd"], log, env=os.environ.copy(), timeout=1800)
    if code != 0:
        say(bad(f"  FAILED ({step['id']}):\n{tail_lines(log, 30)}"))
        return False
    state = load_installed()
    state[step["id"]] = manifest_hash(step)
    save_installed(state)
    return True


def stale_steps(cfg: dict) -> list:
    """Setup steps that never ran (marker missing) or whose dependency manifests changed since they last ran."""
    state = load_installed()
    stale = []
    for step in cfg["setup"]:
        marker_missing = bool(step.get("marker")) and not (ROOT / step["marker"]).exists()
        if step.get("trustExisting") and step.get("marker") and not marker_missing and step["id"] not in state:
            # Dependencies that were here before this tool (an adopted project): take them as they are, and only
            # reinstall when the manifest changes from now on. Reinstalling over a developer's environment could wipe it.
            state[step["id"]] = manifest_hash(step)
            save_installed(state)
            continue
        if marker_missing or state.get(step["id"]) != manifest_hash(step):
            stale.append(step)
    return stale


def ensure_installed(cfg: dict, run: Run) -> bool:
    stale = stale_steps(cfg)
    if not stale:
        return True
    say(dim("  installing dependencies: " + ", ".join(step["id"] for step in stale)))
    return all(run_setup_step(step, run) for step in stale)


# --------------------------------------------------------------------------- desktop applications
#
# Two ways to use a desktop app instead of a command-line program:
#   {claude_desktop}  the Claude Code that the Claude desktop app downloads and updates for its Code tab: run unattended, like `claude -p`
#   handoff:<app>     an app you drive (Claude desktop's Code tab, Cursor, VS Code): the tool opens it, puts the instruction on the
#                     clipboard and waits for you; everything after that (checks, verify, heal) is the same as for any agent


def os_name() -> str:
    return "windows" if IS_WINDOWS else ("macos" if sys.platform == "darwin" else "linux")


def claude_desktop_bases() -> list:
    """Folders where the Claude desktop app keeps the Claude Code it downloads for its Code tab (one folder per version).
    macOS is checked on a real machine. Windows and Linux (the app's beta) follow the same per-user data convention
    (%APPDATA%\\Claude, ~/.config/Claude) but have not been checked; SDLC_CLAUDE_DESKTOP names the program directly when it is elsewhere."""
    if sys.platform == "darwin":
        return [Path.home() / "Library" / "Application Support" / "Claude" / "claude-code"]
    if IS_WINDOWS:
        return [Path(os.environ[name]) / "Claude" / "claude-code" for name in ("APPDATA", "LOCALAPPDATA") if os.environ.get(name)]
    return [Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "Claude" / "claude-code"]


CLAUDE_LAYOUTS = ("claude.exe", "claude", "*/claude.exe", "*/claude", "*/claude.app/Contents/MacOS/claude", "claude.app/Contents/MacOS/claude")


def find_claude_in(base: Path) -> Path | None:
    """The newest Claude Code program under `base`: <version>/<id>/claude.app/Contents/MacOS/claude on macOS, <version>/claude.exe on Windows."""
    def version(folder: Path) -> tuple:
        return tuple(int(n) for n in re.findall(r"\d+", folder.name))

    try:
        folders = sorted((d for d in base.iterdir() if d.is_dir()), key=version, reverse=True)
    except OSError:
        return None
    for folder in folders:
        for pattern in CLAUDE_LAYOUTS:
            for found in sorted(folder.glob(pattern)):
                if found.is_file() and os.access(found, os.X_OK):
                    return found
    return None


def find_claude_desktop() -> str | None:
    """Where the Claude desktop app keeps its own Claude Code (it downloads and updates it separately from any `claude` on PATH),
    or None. SDLC_CLAUDE_DESKTOP names the program directly when it is somewhere else."""
    override = os.environ.get("SDLC_CLAUDE_DESKTOP", "").strip()
    if override:
        path = Path(override).expanduser()
        return str(path) if path.is_file() else None
    for base in claude_desktop_bases():
        found = find_claude_in(base)
        if found:
            return str(found)
    return None


def find_program(program: str) -> str | None:
    """Where an agent's program is: on PATH, or, for {claude_desktop}, where the Claude desktop app keeps it."""
    return find_claude_desktop() if program == CLAUDE_DESKTOP else shutil.which(program)


def expand_command(command: str) -> str:
    """The command with {claude_desktop} replaced by the program's real location (quoted for the shell)."""
    found = find_claude_desktop() if CLAUDE_DESKTOP in command else None
    return command.replace(CLAUDE_DESKTOP, quote_arg(found)) if found else command


def desktop_apps(cfg: dict) -> list:
    return list(cfg["agent"].get("desktopApps", []))


def desktop_app(cfg: dict, app_id: str) -> dict | None:
    return next((a for a in desktop_apps(cfg) if a["id"] == app_id), None)


def desktop_app_path(app: dict) -> str | None:
    """Where the app was found on this machine (best effort: it may be installed somewhere unusual), or None."""
    detect = app.get("detect", {})
    for raw in detect.get(os_name(), []):
        path = Path(os.path.expandvars(os.path.expanduser(raw)))
        if path.exists():
            return str(path)
    for program in detect.get("which", []):
        found = shutil.which(program)
        if found:
            return found
    return None


def open_desktop_app(app: dict, instruction: str) -> str | None:
    """Open the app on this project. Returns the command that worked, or None: the person then opens it themselves."""
    values = {"{dir}": str(ROOT), "{query}": urllib.parse.quote(instruction, safe="")}
    for argv in app.get("open", {}).get(os_name(), []):
        args = []
        for part in argv:
            for key, value in values.items():
                part = part.replace(key, value)
            args.append(part)
        exe = shutil.which(args[0])
        if not exe:
            continue
        try:  # no pipes: a launcher that leaves the app running would keep them open
            done = subprocess.run([exe, *args[1:]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        except (OSError, subprocess.SubprocessError):
            continue
        if done.returncode == 0:
            return " ".join(args)
    return None


def copy_to_clipboard(text: str) -> str | None:
    """Put `text` on the clipboard. Returns the program that did it, or None when there is none (the text is printed anyway)."""
    by_os = {
        "macos": [["pbcopy"]],
        "windows": [["clip"]],
        "linux": [["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]],
    }
    for argv in by_os[os_name()]:
        exe = shutil.which(argv[0])
        if not exe:
            continue
        try:
            done = subprocess.run([exe, *argv[1:]], input=text.encode("utf-8"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        if done.returncode == 0:
            return argv[0]
    return None


def handoff_note(cfg: dict, agent: str) -> None:
    """For a dry run: what a desktop-app agent would do (nothing is opened)."""
    app = desktop_app(cfg, agent[len(HANDOFF):]) if agent.startswith(HANDOFF) else None
    if app:
        say(f"  hand-off      : would open {app['label']} on {ROOT}, copy the instruction, and wait for you to press Enter")


def run_handoff(cfg: dict, app_id: str, prompt_file: Path, tag: str, run_dir: Path) -> int:
    """The agent is a desktop app that a person drives: open it, put the instruction on the clipboard, wait for Enter.
    Returns 0 when the person says the agent is done; Ctrl-C (or no terminal) stops the whole run."""
    app = desktop_app(cfg, app_id)
    if app is None:
        say(bad(f"'{app_id}' is not a desktop app this project knows (known: {', '.join(a['id'] for a in desktop_apps(cfg))})."))
        sys.exit(EXIT_USAGE)
    if not interactive_terminal():
        say(bad(f"{app['label']} is a desktop app you drive, so this needs a terminal to wait in. Nothing was opened."))
        say("Run it in a terminal, or choose an agent that runs by itself: ./<%sdlcDir%>/sdlc agent")
        sys.exit(EXIT_HUMAN)
    instruction = f"Read {rel(prompt_file)} and do exactly what it says."
    say(c(f"\n== hand-off to {app['label']} ==", "1"))
    opened = open_desktop_app(app, instruction)
    copied = copy_to_clipboard(instruction)
    lines = [f"hand-off to {app['label']}", f"opened: {opened or 'no (open it yourself)'}", f"clipboard: {copied or 'no clipboard program found'}", f"instruction: {instruction}"]
    (run_dir / f"{tag}.agent.log").write_text("\n".join(lines) + "\n", encoding="utf-8")
    say(ok(f"  opened {app['label']}") if opened else warn(f"  could not open {app['label']} for you: open it yourself, on this folder: {ROOT}"))
    say(ok("  the instruction is on your clipboard") if copied else warn("  no clipboard program found: copy the instruction below yourself"))
    say(f"\n  Instruction for the agent:  {instruction}\n")
    if app.get("steps"):
        say(textwrap.fill(app["steps"], width=96, initial_indent="  ", subsequent_indent="  "))
    say(dim("  The agent may edit code, tests and dependencies. It may not edit the spec or the gate files: this tool checks that afterwards."))
    try:
        input(c("\nPress Enter when the agent has finished (Ctrl-C to stop): ", "1"))
    except (EOFError, KeyboardInterrupt):
        say("")
        say(warn("Stopped. Nothing was verified; run the same command again when the agent is done."))
        sys.exit(EXIT_HUMAN)
    return 0


def agent_presets(cfg: dict) -> list:
    return list(cfg["agent"].get("presets", []))


def agent_preset_command(cfg: dict, name: str) -> str | None:
    """The command a preset name stands for ("none" = a human does the coding = ""), or None if `name` is not one."""
    if name == "none":
        return ""
    for preset in agent_presets(cfg):
        if preset["id"] == name:
            return preset["command"]
    return None


def read_agent_choice() -> dict:
    """This person's own choice (`./<%sdlcDir%>/sdlc agent`): kept out of git, because every developer has different tools."""
    try:
        data = json.loads(AGENT_LOCAL.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def current_agent(cfg: dict, args: argparse.Namespace | None = None) -> tuple:
    """(command, where it came from). The most specific wins: --agent, SDLC_AGENT_CMD, your own choice, the project default.
    A value that is just a preset's name (`--agent gemini`) means that preset's command."""
    explicit, source = getattr(args, "agent", None), "--agent"
    if explicit is None:
        explicit, source = os.environ.get("SDLC_AGENT_CMD"), "SDLC_AGENT_CMD"
    if explicit is not None:
        explicit = explicit.strip()
        preset = agent_preset_command(cfg, explicit) if explicit else None
        return (explicit if preset is None else preset), source
    mine = "your choice (" + rel(AGENT_LOCAL) + ")"
    choice = read_agent_choice()
    name = str(choice.get("preset", ""))
    if name == "custom" and str(choice.get("command", "")).strip():
        return str(choice["command"]).strip(), mine
    preset = agent_preset_command(cfg, name) if name else None
    if preset is not None:
        return preset, mine
    return cfg["agent"]["command"], "the project default"


def resolve_agent(cfg: dict, args: argparse.Namespace) -> str:
    return current_agent(cfg, args)[0]


def agent_problem(command: str, cfg: dict | None = None) -> str | None:
    """Why this agent command cannot run (its program is not installed), or None."""
    if command.startswith(HANDOFF):  # a desktop app: not finding it is only a note, the person can open it themselves
        cfg = cfg or load_config()
        if desktop_app(cfg, command[len(HANDOFF):]) is None:
            return f"`{command[len(HANDOFF):]}` is not a desktop app this project knows (known: {', '.join(a['id'] for a in desktop_apps(cfg))})"
        return None
    try:
        program = command_program(command)
    except (ValueError, IndexError):
        return "the agent command is empty or malformed"
    if find_program(program) is None:
        if program == CLAUDE_DESKTOP:
            return "the Claude desktop app's Claude Code was not found (install the Claude desktop app and open it once)"
        return f"`{program}` is not installed or not on PATH"
    return None


def agent_table(cfg: dict) -> list:
    """Every agent this project knows, with where its program (or its desktop app) was found (None = not found on this machine)."""
    rows = []
    for preset in agent_presets(cfg):
        if preset["command"].startswith(HANDOFF):
            app = desktop_app(cfg, preset["command"][len(HANDOFF):])
            path = desktop_app_path(app) if app else None
        else:
            path = find_program(preset["program"]) if preset.get("program") else None
        rows.append({**preset, "path": path})
    return rows


def agent_name(cfg: dict, command: str) -> str:
    """The preset a command belongs to ("claude"), "none" for no agent, or the command itself (shortened) if it is custom."""
    if not command:
        return "none"
    for preset in agent_presets(cfg):
        if preset["command"] == command:
            return preset["id"]
    return "custom: " + (command if len(command) <= 60 else command[:57] + "...")


def print_agent_options(cfg: dict, command: str, source: str = "") -> None:
    """Show every agent whether or not it is installed: what to pick now, and how to get the others."""
    say(c("\nAI agents (what drafts specs and writes code for you):", "1"))
    apps_header = False
    for number, row in enumerate(agent_table(cfg), 1):
        is_app = row["command"].startswith(HANDOFF)
        if is_app and not apps_header:
            say(dim("\n  Desktop apps you drive (the tool opens the app and copies the instruction; you press Enter when the agent is done):"))
            apps_header = True
        mark = "*" if command and row["command"] == command else " "
        if is_app:
            state = (ok("found        ") + dim(f" {row['path']}")) if row["path"] else warn("not found here")
        else:
            state = (ok("installed    ") + dim(f" {row['path']}")) if row["path"] else warn("not installed")
        say(f"  {mark}{number:<2} {row['id']:15} {row['label']:34} {state}")
        if not row["path"] and row.get("install"):
            say(dim(f"                  install: {row['install']}"))
    say("   c  custom   any command that reads the prompt on stdin (or names the prompt file with {prompt_file})")
    say("   n  none     a human does the coding; the tool prints the prompt and waits")
    say(f"\nUsing now: {agent_name(cfg, command)}   ({source})")


def save_agent_choice(cfg: dict, name: str, custom: str = "") -> str | None:
    """Remember this person's choice (outside git). Returns the command now in use ("" = none), or None if it is not valid."""
    if name == "custom":
        command = custom.strip()
        if not command:
            say(bad("A custom agent needs its command, e.g.  ./<%sdlcDir%>/sdlc agent custom --command 'my-agent --prompt-stdin'"))
            return None
        data = {"preset": "custom", "command": command}
    else:
        found = agent_preset_command(cfg, name)
        if found is None:
            known = ", ".join([p["id"] for p in agent_presets(cfg)] + ["custom", "none"])
            say(bad(f"Unknown agent '{name}'. Choose one of: {known}."))
            return None
        command, data = found, {"preset": name}
    AGENT_LOCAL.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    say(ok(f"Saved: this project will use {name} on this machine ({rel(AGENT_LOCAL)}; not committed)."))
    if command:
        problem = agent_problem(command, cfg)
        if command.startswith(HANDOFF):
            app = desktop_app(cfg, command[len(HANDOFF):])
            say(dim("  The tool will open the app and wait: you press Enter when its agent is done (this needs a terminal)."))
            if app and not desktop_app_path(app):
                problem = f"{app['label']} was not found on this machine"
        if problem:
            install = next((p["install"] for p in agent_presets(cfg) if p["id"] == name and p.get("install")), "")
            say(warn(f"  {problem}.") + (f" Install it with: {install}" if install else ""))
            say(dim("  Run `./<%sdlcDir%>/sdlc doctor` after installing to check."))
    return command


def choose_agent_interactive(cfg: dict) -> str | None:
    """Ask which agent to use and remember it. Returns the command to use, or None if nothing was chosen."""
    rows = agent_table(cfg)
    try:
        answer = input("\nChoose a number or a name (Enter keeps things as they are): ").strip().lower()
        if not answer:
            return None
        if answer.isdigit():
            if not 1 <= int(answer) <= len(rows):
                say(bad(f"There is no agent number {answer}."))
                return None
            answer = rows[int(answer) - 1]["id"]
        if answer in ("c", "custom"):
            return save_agent_choice(cfg, "custom", input("Command (it reads the prompt on stdin): "))
        return save_agent_choice(cfg, "none" if answer == "n" else answer)
    except (EOFError, KeyboardInterrupt):
        say("")
        return None


def interactive_terminal() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def require_agent(cfg: dict, args: argparse.Namespace, task: str) -> tuple:
    """(command, problem) of the agent that will do `task`. When there is none, or it is not installed, show the options
    (and ask, in a terminal) instead of only failing. (None, None) means nothing can run: the options were shown."""
    agent, source = current_agent(cfg, args)
    problem = agent_problem(agent, cfg) if agent else None
    if agent and not problem and agent.startswith(HANDOFF) and not args.dry_run and not interactive_terminal():
        problem = "a desktop app you drive needs a terminal to wait in, and this is not one"
    if agent and not problem:
        return agent, None
    if args.dry_run and agent:
        return agent, problem  # a dry run only shows the command, so it may name an agent that is not installed here
    say(bad(f"The agent cannot run: {problem}.") if agent else bad(f"No agent is configured, so nothing can {task}."))
    print_agent_options(cfg, agent, source)
    if interactive_terminal() and not args.dry_run:
        chosen = choose_agent_interactive(cfg)
        if chosen and not agent_problem(chosen, cfg):
            return chosen, None
        if chosen is not None:  # a pick that cannot run yet: the choice was saved and how to fix it was already said
            say("\nWith no usable agent nothing can " + task + ". Install it (or pick another with ./<%sdlcDir%>/sdlc agent), then run this again."
                if chosen else "\nWith no agent nothing can " + task + ": a human does the coding. Pick one with ./<%sdlcDir%>/sdlc agent to continue.")
            return None, None
    say("\nChoose one:  ./<%sdlcDir%>/sdlc agent   (or  ./<%sdlcDir%>/sdlc agent <name>,  or add  --agent <name>  to this command)")
    return None, None


def cmd_agent(cfg: dict, args: argparse.Namespace) -> int:
    """List the agents (installed or not) and choose which one this machine uses."""
    if args.reset:
        with contextlib.suppress(FileNotFoundError):
            AGENT_LOCAL.unlink()
        command, source = current_agent(cfg)
        say(ok("Your own choice was removed.") + f" Using {agent_name(cfg, command)}   ({source}).")
        return EXIT_OK
    choice = args.choice
    if args.agent_command and not choice:
        choice = "custom"
    if choice:
        return EXIT_OK if save_agent_choice(cfg, choice, args.agent_command or "") is not None else EXIT_USAGE
    command, source = current_agent(cfg)
    print_agent_options(cfg, command, source)
    if args.list or not interactive_terminal():
        say("\nChoose one:  ./<%sdlcDir%>/sdlc agent <name>      e.g.  ./<%sdlcDir%>/sdlc agent codex"
            "\nOne run:     add  --agent <name>  to spec, implement or loop"
            "\nUndo:        ./<%sdlcDir%>/sdlc agent --reset")
        return EXIT_OK
    choose_agent_interactive(cfg)
    return EXIT_OK


def work_fingerprint() -> str | None:
    """A hash of every uncommitted change (edits to tracked files and the content of untracked ones), so a run can tell whether it
    changed anything. None when this is not a git repository."""
    if not (ROOT / ".git").exists():
        return None
    h = hashlib.sha256(git("diff", "HEAD").encode("utf-8", "replace"))
    for name in sorted(git("ls-files", "--others", "--exclude-standard").splitlines()):
        path = ROOT / name
        h.update(name.encode("utf-8", "replace"))
        if path.is_file():
            h.update(path.read_bytes())
    return h.hexdigest()


def dirty_files(exclude: Path) -> list:
    """Uncommitted changes other than the feature's own spec folder (empty when not a git repository)."""
    if not (ROOT / ".git").exists():
        return []
    skip = rel(exclude).rstrip("/") + "/"
    out = []
    for line in git_porcelain():
        name = line[3:].split(" -> ")[-1].strip().strip('"')
        if not name.startswith(skip) and not name.startswith(".ai/evidence"):
            out.append(line)
    return out


def listing(pattern: str) -> str:
    items = sorted(p for p in ROOT.glob(pattern))
    return ", ".join(f"`{rel(p)}`" for p in items) or "(none)"


# --------------------------------------------------------------------------- requirements documents -> spec


SPEC_SOURCES = (".pdf", ".docx", ".md", ".markdown", ".txt", ".rst")
MAX_SOURCE_CHARS = 40000
PDF_ESCAPES = {b"n": b"\n", b"r": b"\r", b"t": b"\t", b"b": b"\b", b"f": b"\f", b"(": b"(", b")": b")", b"\\": b"\\"}
SOFT_BREAK = "\x00"
JOIN = "\x01"
PDF_LIGATURES = {0xFB00: "ff", 0xFB01: "fi", 0xFB02: "fl", 0xFB03: "ffi", 0xFB04: "ffl", 0xFB05: "st", 0xFB06: "st"}
PDF_TOKEN = re.compile(rb"\((?:\\.|[^\\()])*\)|<[0-9A-Fa-f\s]*>|\[|\]|/[^\s/\[\]()<>]*|[-+]?\d*\.?\d+|[A-Za-z'\"*]+", re.S)


def looks_like_text(text: str | None) -> bool:
    """Enough real words to be a usable extraction (a garbled or empty one must not be trusted)."""
    return bool(text) and len(re.findall(r"[A-Za-z]{3,}", text)) >= 15


def docx_text(path: Path) -> str:
    import xml.etree.ElementTree as ET
    import zipfile

    w = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
    with zipfile.ZipFile(path) as z:
        root = ET.fromstring(z.read("word/document.xml"))
    lines = []
    for para in root.iter(w + "p"):
        parts = []
        for node in para.iter():
            if node.tag == w + "t":
                parts.append(node.text or "")
            elif node.tag == w + "tab":
                parts.append("\t")
            elif node.tag in (w + "br", w + "cr"):
                parts.append("\n")
        lines.append("".join(parts))
    return "\n".join(lines)


def pdf_text_poppler(path: Path) -> str | None:
    exe = shutil.which("pdftotext")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "-layout", "-enc", "UTF-8", str(path), "-"], capture_output=True, encoding="utf-8", errors="replace", timeout=180)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def pdf_text_pypdf(path: Path) -> str | None:
    for name in ("pypdf", "PyPDF2"):
        try:
            lib = __import__(name)
        except ImportError:
            continue
        try:
            return "\n\n".join((page.extract_text() or "") for page in lib.PdfReader(str(path)).pages)
        except Exception:  # a damaged or encrypted PDF: let the next extractor try
            return None
    return None


def pdf_text_mutool(path: Path) -> str | None:
    exe = shutil.which("mutool")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "draw", "-q", "-F", "txt", "-o", "-", str(path)], capture_output=True, encoding="utf-8", errors="replace", timeout=180)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def pdf_literal(token: bytes) -> bytes:
    body, out, i = token[1:-1], bytearray(), 0
    while i < len(body):
        ch = body[i:i + 1]
        if ch == b"\\" and i + 1 < len(body):
            nxt = body[i + 1:i + 2]
            if nxt in PDF_ESCAPES:
                out += PDF_ESCAPES[nxt]
                i += 2
            elif nxt.isdigit():  # octal \ddd
                j = i + 1
                while j < len(body) and j < i + 4 and body[j:j + 1].isdigit():
                    j += 1
                out.append(int(body[i + 1:j], 8) & 0xFF)
                i = j
            else:  # line continuation or an unknown escape
                i += 2
            continue
        out += ch
        i += 1
    return bytes(out)


def pdf_unfilter(header: bytes, body: bytes) -> bytes | None:
    """Apply a PDF stream's /Filter chain. None = a filter we cannot undo (images, LZW, encryption)."""
    import base64
    import zlib

    found = re.search(rb"/Filter\s*(\[[^\]]*\]|/[A-Za-z0-9]+)", header)
    if not found:
        return body
    for name in re.findall(rb"/([A-Za-z0-9]+)", found.group(1)):
        if name in (b"FlateDecode", b"Fl"):
            try:
                body = zlib.decompress(body)
            except zlib.error:
                try:
                    body = zlib.decompressobj().decompress(body)
                except zlib.error:
                    return None
        elif name in (b"ASCII85Decode", b"A85"):
            data = body.strip()
            data = data[2:] if data.startswith(b"<~") else data
            data = data[:-2] if data.endswith(b"~>") else data
            try:
                body = base64.a85decode(data)
            except ValueError:
                return None
        elif name in (b"ASCIIHexDecode", b"AHx"):
            digits = re.sub(rb"[^0-9A-Fa-f]", b"", body.split(b">")[0])
            body = bytes.fromhex((digits + b"0" * (len(digits) % 2)).decode())
        else:
            return None
    return body


def parse_cmap(text: str) -> tuple:
    """(code -> text, code width in bytes or 0 if unknown) from a PDF ToUnicode CMap (bfchar and bfrange)."""
    def dec(h: str) -> str:
        raw = bytes.fromhex(h if len(h) % 2 == 0 else h + "0")
        return raw.decode("utf-16-be", errors="ignore") if len(raw) % 2 == 0 else raw.decode("latin-1")

    mapping: dict = {}
    width = 0
    for block in re.findall(r"begincodespacerange(.*?)endcodespacerange", text, re.S):
        for lo, _hi in re.findall(r"<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>", block):
            width = max(width, len(lo) // 2)
    for block in re.findall(r"beginbfchar(.*?)endbfchar", text, re.S):
        for src, dst in re.findall(r"<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>", block):
            mapping[int(src, 16)] = dec(dst)
    for block in re.findall(r"beginbfrange(.*?)endbfrange", text, re.S):
        for lo, hi, rest in re.findall(r"<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>\s*(\[[^\]]*\]|<[0-9A-Fa-f]+>)", block):
            lo_i, hi_i = int(lo, 16), min(int(hi, 16), int(lo, 16) + 65535)
            if rest.startswith("["):
                for k, d in enumerate(re.findall(r"<([0-9A-Fa-f]+)>", rest)):
                    mapping[lo_i + k] = dec(d)
            else:
                base = dec(rest[1:-1])
                for k in range(hi_i - lo_i + 1):
                    mapping[lo_i + k] = (base[:-1] + chr(ord(base[-1]) + k)) if base else ""
    return mapping, width


def pdf_text_builtin(data: bytes) -> str:
    """A basic, dependency-free extractor: stream filters, text operators, ToUnicode maps. Best effort only."""
    cmap: dict = {}
    cmap_width = 0
    contents = []
    for m in re.finditer(rb"(?<!end)stream\r?\n(.*?)\r?\n?endstream", data, re.S):
        header = data[max(0, m.start() - 500):m.start()].rsplit(b"obj", 1)[-1]
        body = pdf_unfilter(header, m.group(1))
        if body is None:
            continue
        if b"beginbfchar" in body or b"beginbfrange" in body:
            mapping, width = parse_cmap(body.decode("latin-1"))
            cmap.update(mapping)
            cmap_width = max(cmap_width, width)
        elif b"BT" in body and b"ET" in body:
            contents.append(body)

    def decode(tok: bytes) -> str:
        if tok.startswith(b"("):
            raw, hexa = pdf_literal(tok), False
        else:
            digits = re.sub(rb"\s", b"", tok[1:-1]).decode()
            raw, hexa = bytes.fromhex(digits if len(digits) % 2 == 0 else digits + "0"), True
        if not cmap:
            return raw.decode("latin-1")
        two_byte = cmap_width == 2 or (cmap_width == 0 and hexa and max(cmap) > 255)
        width = 2 if (two_byte and len(raw) % 2 == 0) else 1
        out = []
        for i in range(0, len(raw), width):
            code = int.from_bytes(raw[i:i + width], "big")
            out.append(cmap.get(code, chr(code) if width == 1 and 32 <= code < 127 else ""))
        return "".join(out)

    pieces: list = []
    for body in contents:
        stack: list = []
        array: list = []
        in_array, last_y = False, None
        # Chrome, Skia and some other producers place EVERY glyph with its own move (`8.1 0 Td <0052> Tj`) and write
        # spaces as real glyphs. A horizontal move then means "next letter", not "next word", so it must not add a space.
        shown = re.findall(rb"(<[0-9A-Fa-f\s]*>|\((?:\\.|[^\\()])*\))\s*Tj", body)
        per_glyph = len(shown) >= 8 and sum(1 for s in shown if len(decode(s)) <= 1) / len(shown) > 0.7
        for tok in PDF_TOKEN.findall(body):
            if tok == b"[":
                in_array, array = True, []
            elif tok == b"]":
                in_array = False
                stack.append(("array", array))
            elif tok[:1] in (b"(", b"<"):
                (array if in_array else stack).append(("str", tok))
            elif tok[:1] in (b"+", b"-", b".") or tok[:1].isdigit():
                (array if in_array else stack).append(("num", float(tok)))
            elif tok.startswith(b"/"):
                stack.append(("name", tok))
            else:
                op = tok.decode("latin-1")
                top = stack[-1] if stack else None
                if op == "Tj" and top and top[0] == "str":
                    pieces.append(decode(top[1]))
                elif op == "TJ" and top and top[0] == "array":
                    for kind, val in top[1]:
                        if kind == "str":
                            pieces.append(decode(val))
                        elif kind == "num" and val < -200:
                            pieces.append(" ")
                elif op in ("'", '"') and top and top[0] == "str":
                    pieces.append("\n" + decode(top[1]))
                elif op == "T*":
                    pieces.append("\n")
                elif op in ("ET", "BT"):
                    pieces.append(SOFT_BREAK)  # a new text block is a new line only if the next one is placed lower
                elif op in ("Td", "TD") and top and top[0] == "num":
                    pieces.append("\n" if top[1] != 0 else ("" if per_glyph else " "))
                elif op == "Tm" and top and top[0] == "num":
                    while pieces and pieces[-1] == SOFT_BREAK:
                        pieces.pop()
                    if last_y is None or abs(top[1] - last_y) > 1:
                        pieces.append("\n")
                    else:  # same line: browsers start a new block for every style change (bold, code, link) and table cell
                        pieces.append(JOIN if per_glyph else " ")
                    last_y = top[1]
                stack = []
    text = "".join(pieces).replace(SOFT_BREAK, "\n").translate(PDF_LIGATURES)
    # a JOIN between two blocks on one line is a space, unless the text already has one there or punctuation follows
    text = re.sub(r"(?<=[\s(\[])" + JOIN + r"|" + JOIN + r"(?=[\s.,;:!?)\]]|$)", "", text).replace(JOIN, " ")
    text = re.sub(r"[ \t]+\n", "\n", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def pdf_reader_name() -> str:
    if shutil.which("pdftotext"):
        return "pdftotext"
    for name in ("pypdf", "PyPDF2"):
        try:
            __import__(name)
            return name
        except ImportError:
            pass
    return "mutool" if shutil.which("mutool") else "built-in basic extractor"


def extract_source(path: Path) -> tuple:
    """(text or None, how it was extracted)."""
    ext = path.suffix.lower()
    if ext == ".docx":
        try:
            return docx_text(path), "docx (paragraph text; tables are flattened)"
        except Exception as e:  # not a valid docx
            return None, f"could not read the .docx ({e})"
    if ext != ".pdf":
        return path.read_text(encoding="utf-8", errors="replace"), "plain text"
    for how, fn in (("pdftotext", pdf_text_poppler), ("pypdf", pdf_text_pypdf), ("mutool", pdf_text_mutool)):
        text = fn(path)
        if looks_like_text(text):
            return text, how
    try:
        text = pdf_text_builtin(path.read_bytes())
    except Exception:
        text = None
    if looks_like_text(text):
        return text, "the built-in basic extractor: text may be incomplete or out of order, so prefer the original file if your tools can read PDFs"
    return None, "no text could be extracted (a scanned/image PDF needs OCR, or the PDF is protected); read the original file with your own tools"


def create_spec_dir(cfg: dict, slug: str, title: str) -> Path:
    base = ROOT / cfg["facts"]["specsDir"]
    fid = next_feature_id(cfg)
    dest = base / f"{fid}-{slug}"
    shutil.copytree(base / "_template", dest)
    for f in dest.iterdir():
        f.write_text(f.read_text(encoding="utf-8").replace("{{ID}}", fid).replace("{{TITLE}}", title).replace("{{SLUG}}", slug), encoding="utf-8")
    return dest


# Words that describe the document, not the feature: "Customer Login Requirements" is the feature "customer-login".
# Only stripped at the end of a title ("Document Upload" keeps its first word) or after a leading "Requirements for".
DOCUMENT_WORDS = {"requirement", "requirements", "specification", "specifications", "spec", "specs", "prd", "document", "doc", "brief", "draft"}
MAX_NAME_WORDS = 5


def feature_slug_from_prd(prd_text: str) -> str | None:
    """The folder name a PRD's own title asks for: `# FEAT-001: Customer Login` -> `customer-login`; None if the title says nothing."""
    first = next((ln for ln in prd_text.splitlines() if ln.strip()), "")
    m = re.match(r"#\s*FEAT-\d+\s*[:\-\u2013\u2014]\s*(.+)$", first.strip())
    if not m or "TODO(prd)" in m.group(1):
        return None
    words = [w for w in slugify(m.group(1)).split("-") if w]
    if len(words) > 2 and words[0] in DOCUMENT_WORDS and words[1] in ("for", "of"):
        words = words[2:]
    while words and words[-1] in DOCUMENT_WORDS:
        words.pop()
    return "-".join(words[:MAX_NAME_WORDS]) or None


def spec_dirs_made_from(specs_dir: Path, src: Path) -> list[Path]:
    """Specs already drafted from this very document (its copy is in source/), whatever their folder is called now."""
    found = []
    for p in sorted(specs_dir.glob("FEAT-*")):
        copy = p / "source" / src.name
        try:
            if copy.is_file() and copy.read_bytes() == src.read_bytes():
                found.append(p)
        except OSError:
            continue
    return found


def name_spec_after_feature(specs_dir: Path, spec_dir: Path) -> Path:
    """Rename `FEAT-001-requirements` (the file's name) to `FEAT-001-customer-login` (the feature's name) once the PRD has a real title."""
    parts = spec_dir.name.split("-", 2)
    slug = feature_slug_from_prd((spec_dir / "prd.md").read_text(encoding="utf-8"))
    if len(parts) < 3 or not slug or slug == parts[2]:
        return spec_dir
    target = specs_dir / f"{parts[0]}-{parts[1]}-{slug}"
    if any(p.name.split("-", 2)[2:] == [slug] for p in specs_dir.glob("FEAT-*") if p != spec_dir):
        say(warn(f"  kept the folder name {spec_dir.name}: another spec is already called '{slug}' (rename the folder yourself if you want another name)"))
        return spec_dir
    old_rel = rel(spec_dir)
    spec_dir.rename(target)
    for name in ("prd.md", "acceptance.json"):  # the draft may cite its own folder, for example the copy of the source
        f = target / name
        if f.exists():
            text = f.read_text(encoding="utf-8")
            if old_rel in text:
                f.write_text(text.replace(old_rel, rel(target)), encoding="utf-8")
    say(f"  named the spec after the feature: {rel(target)}/  (was {spec_dir.name}; pass --name to choose another)")
    return target


def cmd_spec(cfg: dict, args: argparse.Namespace) -> int:
    """Requirements document in, reviewed-by-you spec out: the agent drafts, the tool validates and sends errors back."""
    src = Path(args.source).expanduser().resolve()
    if not src.is_file():
        say(bad(f"No such file: {args.source}"))
        return EXIT_HUMAN
    if src.suffix.lower() not in SPEC_SOURCES:
        say(bad(f"Unsupported file type '{src.suffix}'. Supported: {', '.join(SPEC_SOURCES)}"))
        return EXIT_HUMAN
    say(c(f"\n=== spec from {src.name} ===", "1;35"))

    agent, problem = require_agent(cfg, args, "draft the spec")
    if agent is None:
        return EXIT_HUMAN

    specs_dir = ROOT / cfg["facts"]["specsDir"]
    slug = slugify(args.name or src.stem)
    existing = [p for p in sorted(specs_dir.glob("FEAT-*")) if p.name.split("-", 2)[2] == slug]
    if not existing and not args.name:
        existing = spec_dirs_made_from(specs_dir, src)  # a spec named after its feature is still found by its source document
    spec_dir = existing[0] if existing else None
    if spec_dir is not None:
        prd = spec_dir / "prd.md"
        if prd.exists() and "TODO(prd)" not in prd.read_text(encoding="utf-8"):
            say(bad(f"{rel(spec_dir)} already has a finished PRD; this would overwrite your work."))
            say("Choose another name with --name, or delete the folder first.")
            return EXIT_HUMAN
    planned = spec_dir or specs_dir / f"{next_feature_id(cfg)}-{slug}"
    if not (ROOT / ".git").exists():
        say(warn("  not a git repository: the agent's changes cannot be reviewed or reverted easily (run `git init` first)"))
    dirty = dirty_files(planned)
    if dirty and not args.allow_dirty:
        say(bad("You have uncommitted changes outside the new spec:"))
        for line in dirty[:15]:
            say(f"  {line}")
        say("Commit or stash them first so you can see exactly what the agent changes (or pass --allow-dirty).")
        return EXIT_HUMAN

    text, how = extract_source(src)
    run = Run(f"spec-{slug}")
    if text:
        (run.dir / "source.txt").write_text(text, encoding="utf-8")
        say(ok(f"  read {src.name}: {len(text):,} characters via {how.split(':')[0]}"))
    else:
        say(warn(f"  {how}"))
    shown = text[:MAX_SOURCE_CHARS] if text else "(no text could be extracted: read the file at the path above with your own file tools)"
    if text and len(text) > MAX_SOURCE_CHARS:
        shown += f"\n\n[... truncated: {len(text) - MAX_SOURCE_CHARS:,} more characters. The full text is in {rel(run.dir / 'source.txt')}, and the original file is at the path above ...]"
    targets = ", ".join(f"`{n}` ({u})" for n, u in cfg["runtime"]["targets"].items()) or "(none)"
    source_in_spec = planned / "source" / src.name
    questions = run.dir / "QUESTIONS.md"
    values = {
        "feature": planned.name.split("-", 2)[0] + "-" + planned.name.split("-", 2)[1],
        "specDir": rel(planned), "sourceName": src.name, "sourcePath": rel(source_in_spec),
        "focus": args.focus or "the whole document", "extractor": how, "sourceText": shown,
        "targets": targets, "questionsFile": rel(questions),
    }
    prompt = render_prompt(cfg["agent"]["prompts"]["spec"], values)
    if args.dry_run:
        prompt_file = run.dir / "spec.prompt.md"
        prompt_file.write_text(prompt, encoding="utf-8")
        say(ok("\nDry run: nothing was executed or created."))
        say(f"  agent command : {agent}" + (f"   (WARNING: {problem})" if problem else ""))
        handoff_note(cfg, agent)
        named_later = spec_dir is None and not args.name
        folder = f"{rel(specs_dir)}/{values['feature']}-<feature name>" if named_later else rel(planned)
        say(f"  would create  : {folder}/  (prd.md, acceptance.json, and a copy of the source in source/)")
        if named_later:
            say(f"                  the folder is named after the feature in the PRD's title once the draft is valid; pass --name <slug> to choose it now")
        say(f"  prompt        : {rel(prompt_file)}  ({len(prompt.splitlines())} lines, includes the document text)")
        return EXIT_OK

    if spec_dir is None:
        spec_dir = create_spec_dir(cfg, slug, args.name.replace("-", " ").title() if args.name else src.stem.replace("-", " ").replace("_", " ").title())
        say(f"  created {rel(spec_dir)}/")
    (spec_dir / "source").mkdir(exist_ok=True)
    shutil.copy2(src, spec_dir / "source" / src.name)

    # the agent may write the two spec files and nothing else
    integ = cfg["integrity"]
    others = [rel(d) for d in specs_dir.iterdir() if d.is_dir() and d != spec_dir]
    guard = integ["protected"] + others
    before_snap, before_dirty = snapshot(guard), set(dirty_files(spec_dir))
    targets_set = set(cfg["runtime"]["targets"])
    for attempt in range(1, args.max_attempts + 1):
        say(c(f"\n== agent: drafting the spec (attempt {attempt}/{args.max_attempts}) ==", "1"))
        code = run_agent(cfg, agent, prompt, f"spec-{attempt}", run.dir)
        blocker = agent_blocker(run.dir, f"spec-{attempt}", code)
        if blocker:
            explain_blocker(agent, blocker)
            return EXIT_HUMAN
        if code != 0:
            say(warn(f"  the agent exited with {code}; validation below decides whether the draft is usable"))
        stray = sorted(set(dirty_files(spec_dir)) - before_dirty)
        violations = changed(before_snap, snapshot(guard)) + stray
        if violations:
            say(bad("\nINTEGRITY VIOLATION: spec drafting may only write files inside the new spec folder, but these changed:"))
            for v in violations:
                say(bad(f"  - {v}"))
            say("Revert them (git checkout -- <path>; remove untracked files) and run again.")
            (run.dir / "integrity-violation.md").write_text("\n".join(violations), encoding="utf-8")
            return EXIT_INTEGRITY
        if questions.exists() and questions.read_text(encoding="utf-8").strip():
            say(bad("\nThe agent could not draft a spec:"))
            say(questions.read_text(encoding="utf-8").strip())
            return EXIT_HUMAN
        spec = next((sp for sp in load_specs(cfg) if sp["dir"] == spec_dir), None)
        good, errors = traceability(spec, targets_set) if spec else (False, ["the spec folder disappeared"])
        if good:
            break
        say(warn(f"  the draft is not valid yet ({len(errors)} problem(s)):"))
        for e in errors[:10]:
            say(f"    - {e}")
        if attempt == args.max_attempts:
            say(bad(f"\nThe draft is still invalid after {attempt} attempts. Fix {rel(spec_dir)}/ by hand (skills: write-prd, write-fact-checks)."))
            return EXIT_FAIL
        prompt = render_prompt(cfg["agent"]["prompts"]["specFix"], {
            "feature": values["feature"], "specDir": values["specDir"], "sourceName": src.name, "targets": targets,
            "attempt": attempt + 1, "maxAttempts": args.max_attempts, "errors": "\n".join(f"- {e}" for e in errors),
        })

    if not args.name:
        spec_dir = name_spec_after_feature(specs_dir, spec_dir)
    prd_text = (spec_dir / "prd.md").read_text(encoding="utf-8")
    assumptions = len(re.findall(r"ASSUMPTION", prd_text))
    say(ok(f"\nDraft ready: {rel(spec_dir)}/"))
    say(f"  {len(spec['acs'])} acceptance criteria, {len(spec['checks'])} checks, {assumptions} assumption(s) for you to confirm")
    say(warn("This is a DRAFT written by an AI. Read it before anyone implements it (skill: .ai/skills/review-spec):"))
    say(f"  1. compare {rel(spec_dir / 'prd.md')} and acceptance.json with {src.name} (each criterion cites its source)")
    say("  2. confirm or change every ASSUMPTION and answer the open questions, then set `Status: Accepted`")
    say(f"  3. ./<%sdlcDir%>/sdlc implement {values['feature']}")
    return EXIT_OK


# --------------------------------------------------------------------------- onboard: an agent maps the existing code, the tool checks what it can
#
# The agent drafts two files (a map of the repository and the conventions its code follows) and a person reviews them. An AI's
# description of a code base is only worth having if it is true, so the tool checks everything that can be checked mechanically
# against the repository itself: every path the draft cites exists, every `npm run x` / `make x` / `sdlc x` it names is real, every
# convention points at the code it was seen in, and nothing is left as a placeholder. What it cannot check (is the description
# right?) stays with the person, and the files say so with `Status: Draft` until they have been read.

ONBOARD_MIN_CHARS = 300
# A name with one of these extensions is taken to be a file; names without one are only checked when they contain a "/".
PATH_EXTENSIONS = {
    "json", "toml", "yaml", "yml", "md", "py", "ts", "tsx", "js", "jsx", "mjs", "cjs", "go", "rs", "java", "kt", "rb", "php", "cs",
    "sh", "cfg", "ini", "txt", "lock", "sql", "html", "css", "scss", "xml", "gradle", "mk", "env", "tf", "vue", "svelte",
}
# Generated or installed locations: a draft may mention them without them being in the repository.
GENERATED_TOP = {"node_modules", "dist", "build", ".venv", "venv", "__pycache__", ".next", ".nuxt", ".output", "coverage", "target", ".git", ".tox", ".cache", ".mypy_cache"}
GUIDANCE_FILES = ("AGENTS.md", "CLAUDE.md", "GEMINI.md", "CONVENTIONS.md", ".cursorrules", ".windsurfrules", ".github/copilot-instructions.md")
TREE_SKIP = GENERATED_TOP | {".pytest_cache", ".ruff_cache", ".turbo", ".idea", ".gradle", ".terraform"}
CODE_FENCE = re.compile(r"^(```|~~~).*?^\1[^\n]*$", re.M | re.S)
CODE_SPAN = re.compile(r"`([^`\n]+)`")
RUN_SCRIPT = re.compile(r"(?<![\w./-])(?:npm|pnpm|yarn|bun)\s+run\s+([A-Za-z0-9:_.-]+)")
MAKE_TARGET = re.compile(r"(?<![\w./-])make\s+([A-Za-z0-9_.-]+)")
SDLC_COMMAND = re.compile(r"(?<![\w-])\.?[/\\]?\.ai[/\\]sdlc(?:\.cmd)?\s+([a-z][a-z-]*)")
BOLD_BULLET = re.compile(r"^[-*]\s+\*\*")
STATUS_DRAFT = re.compile(r"^Status:\s*Draft", re.I | re.M)


def repo_files() -> list:
    """Every file of the repository the way git sees it (tracked, and untracked but not ignored); a folder walk without git."""
    if (ROOT / ".git").exists():
        listed = git("ls-files", "-co", "--exclude-standard")
        if listed:
            return sorted({f for f in listed.splitlines() if not f.startswith(".ai/evidence/")})
    files = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = sorted(d for d in dirnames if d not in TREE_SKIP)
        for name in sorted(filenames):
            path = Path(dirpath, name).relative_to(ROOT).as_posix()
            if not path.startswith(".ai/evidence/"):
                files.append(path)
    return files


def repo_tree(files: list, depth: int = 3, max_lines: int = 160) -> str:
    """A bounded map of the repository: top-level files, then folders (with how many files each holds), breadth first."""
    counts: dict = {}
    for f in files:
        parts = f.split("/")
        for d in range(1, min(len(parts), depth + 1)):
            key = "/".join(parts[:d])
            counts[key] = counts.get(key, 0) + 1
    top_files = [f for f in files if "/" not in f]
    lines = [f"{name}" for name in top_files[:40]] + ([f"... {len(top_files) - 40} more files at the top level"] if len(top_files) > 40 else [])
    shown = sorted(counts, key=lambda k: (k.count("/"), k))[: max(0, max_lines - len(lines))]
    lines += [f"{k}/  ({counts[k]} file{'s' if counts[k] != 1 else ''})" for k in sorted(shown)]
    if len(counts) > len(shown):
        lines.append(f"... {len(counts) - len(shown)} more folders below this depth or beyond the line limit")
    return "\n".join(lines) or "(empty)"


def existing_guidance(files: list) -> list:
    return [f for f in files if f in GUIDANCE_FILES or f.startswith(".cursor/rules/")]


def strip_fences(text: str) -> str:
    return CODE_FENCE.sub("", text)


def path_claim(span: str) -> str | None:
    """The repository path a backticked span claims to be, or None when it is not (clearly) a path: a URL, a route (/api/x),
    a command, a package name, a method call. A name with a "/" is checked when its first part is a folder of this repository,
    when it ends with "/", or when it looks like a file; a bare name only when it looks like a file."""
    s = re.sub(r":\d+(?:-\d+)?$", "", span.strip())
    if s.startswith("./"):
        s = s[2:]
    if not s or not re.fullmatch(r"[A-Za-z0-9_.@+*/-]+", s) or s.startswith(("/", "@", "-", ".../")) or "//" in s or ".." in s.split("/"):
        return None
    first = s.split("/")[0]
    if first in GENERATED_TOP or s.startswith(".ai/evidence"):
        return None
    last = s.rstrip("/").rsplit("/", 1)[-1]
    filey = "." in last and last.rsplit(".", 1)[-1].lower() in PATH_EXTENSIONS
    if "/" in s:
        return s if s.endswith("/") or filey or (ROOT / first).exists() or "*" in first else None
    return s if filey or ("*" in s and "." in last) else None


# Names of the files and folders anywhere in the repository (filled by validate_onboard). A draft that says "`ConfigForm.tsx`" or "`core/`"
# under a folder it has just named is citing something real, and rejecting it would only teach agents to repeat the folder in every sentence.
REPO_NAMES: set = set()


def git_ignored(claim: str) -> bool:
    """A path git ignores is a generated or local artefact (a build output, a virtual environment): citing it is not citing something that should be committed."""
    if not (ROOT / ".git").exists():
        return False
    try:
        return subprocess.run(["git", "check-ignore", "-q", "--", claim], cwd=str(ROOT), capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def path_exists(claim: str) -> bool:
    bare = "/" not in claim.rstrip("/")
    if "*" in claim:
        if bare:  # `*.test.ts`: some file or folder with a matching name
            return any(fnmatch.fnmatch(name, claim.rstrip("/")) for name in REPO_NAMES)
        try:
            return next(ROOT.glob(claim.rstrip("/")), None) is not None
        except (ValueError, NotImplementedError, OSError):
            return False
    if (ROOT / claim.rstrip("/")).exists():
        return True
    if bare and (claim.rstrip("/") in REPO_NAMES or (claim.startswith(".") and any(name.endswith(claim) for name in REPO_NAMES))):
        return True  # a name (`orders.js`, `core/`) or a suffix (`.test.ts`) that exists somewhere
    return git_ignored(claim)


def suggest_paths(claim: str) -> str:
    """For a cited file that is not where the draft says: the files of that name that do exist elsewhere."""
    name = claim.rstrip("/").rsplit("/", 1)[-1]
    close = [f for f in repo_files() if f.rsplit("/", 1)[-1] == name][:3]
    return f" (did you mean {', '.join('`' + f + '`' for f in close)}?)" if close else ""


def code_text(text: str) -> str:
    """What a draft marks as code: fenced blocks and backticked spans (prose like "make sure" is not a command)."""
    fenced = [m.group(0) for m in CODE_FENCE.finditer(text)]
    return "\n".join(fenced + CODE_SPAN.findall(strip_fences(text)))


def repo_scripts() -> tuple:
    """(package.json script names anywhere in the repository, Makefile targets)."""
    scripts, targets = set(), set()
    for f in repo_files():
        name = f.rsplit("/", 1)[-1]
        try:
            if name == "package.json":
                scripts |= set((json.loads((ROOT / f).read_text(encoding="utf-8")).get("scripts") or {}))
            elif name in ("Makefile", "makefile", "GNUmakefile"):
                targets |= set(re.findall(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", (ROOT / f).read_text(encoding="utf-8", errors="replace"), re.M))
        except (OSError, ValueError, AttributeError):
            continue
    return scripts, targets


def sdlc_commands() -> set:
    parsers = next(a for a in build_parser()._actions if isinstance(a, argparse._SubParsersAction))
    return set(parsers.choices)


def evidence_blocks(text: str) -> list:
    """Bold-led list items ("- **Thing**: ...") with everything indented under them, outside an "open questions" section."""
    blocks, current, skipping = [], None, False
    for line in text.splitlines():
        if re.match(r"^#{1,6}\s", line):
            skipping = bool(re.search(r"open question|assumption|unknown|conflict|not sure", line, re.I))
            if current is not None:
                blocks.append(current)
                current = None
        elif BOLD_BULLET.match(line):
            if current is not None:
                blocks.append(current)
            current = None if skipping else [line]
        elif current is not None and (line.strip() == "" or line.startswith((" ", "\t"))):
            current.append(line)
        elif current is not None:
            blocks.append(current)
            current = None
    if current is not None:
        blocks.append(current)
    return ["\n".join(b) for b in blocks]


def check_context_file(path: str, text: str, headings: list, min_items: int) -> tuple:
    """Everything about one drafted file that can be checked against the repository. Returns (problems, stats)."""
    problems, stats = [], {"paths": 0, "commands": 0}
    if len(text.strip()) < ONBOARD_MIN_CHARS:
        problems.append(f"{path} is nearly empty ({len(text.strip())} characters): describe what is actually in the repository")
    if "TODO(onboard)" in text:
        problems.append(f"{path} still contains TODO(onboard) placeholders")
    if not STATUS_DRAFT.search("\n".join(text.splitlines()[:8])):
        problems.append(f"{path}: the first lines must include `Status: Draft (drafted by an agent; a human must review it)`")
    for label, pattern in headings:
        if not re.search(rf"^#{{1,6}}\s*.*(?:{pattern})", text, re.I | re.M):
            problems.append(f"{path}: missing a section about {label} (a heading containing: {pattern.replace('|', ' / ')})")

    prose = strip_fences(text)
    seen: set = set()
    for span in CODE_SPAN.findall(prose):
        claim = path_claim(span)
        if claim is None or claim in seen:
            continue
        seen.add(claim)
        stats["paths"] += 1
        if not path_exists(claim):
            problems.append(f"{path} cites `{claim}`, which does not exist in this repository (paths are relative to the repository root){suggest_paths(claim)}")

    scripts, targets = repo_scripts()
    commands = sdlc_commands()
    code = code_text(text)
    for name in sorted(set(RUN_SCRIPT.findall(code))):
        stats["commands"] += 1
        if name not in scripts:
            problems.append(f"{path} names `... run {name}`, but no package.json defines a script called {name} (defined: {', '.join(sorted(scripts)) or 'none'})")
    for name in sorted(set(MAKE_TARGET.findall(code))):
        stats["commands"] += 1
        if name not in targets:
            problems.append(f"{path} names `make {name}`, but no Makefile defines that target (defined: {', '.join(sorted(targets)) or 'no Makefile'})")
    for name in sorted(set(SDLC_COMMAND.findall(code))):
        stats["commands"] += 1
        if name not in commands:
            problems.append(f"{path} names `sdlc {name}`, which is not a command (commands: {', '.join(sorted(commands))})")

    items = evidence_blocks(text)
    if len(items) < min_items:
        problems.append(f"{path}: expected at least {min_items} bold-led items (`- **Name**: ...`), found {len(items)}")
    for block in items:
        claims = [p for p in (path_claim(s) for s in CODE_SPAN.findall(strip_fences(block))) if p]
        if not any(path_exists(p) for p in claims):
            problems.append(f"{path}: this item cites no existing file as evidence (name where in the code it was seen, in backticks): {block.strip().splitlines()[0][:90]}")
    return problems, stats


ONBOARD_SECTIONS = {
    "architecture": ([("what this is", "purpose|overview|what this"), ("the layout", "layout|structure"), ("entry points", "entry points?"),
                      ("open questions", "open questions|assumptions|unknown")], 3),
    "conventions": ([("conventions", "convention"), ("open questions and conflicts", "open questions|conflict|unclear|not sure")], 3),
}


def validate_onboard(cfg: dict) -> tuple:
    problems, stats = [], {"paths": 0, "commands": 0, "files": 0}
    REPO_NAMES.clear()
    for f in repo_files():
        if not f.startswith(".ai/"):  # the overlay's own files (sdlc.py, commands.md) must not vouch for names a draft claims about the project
            REPO_NAMES.update(f.split("/"))
    for key, (headings, min_items) in ONBOARD_SECTIONS.items():
        path = cfg["onboard"][key]
        file = ROOT / path
        if not file.is_file():
            problems.append(f"{path} was not written")
            continue
        found, counts = check_context_file(path, file.read_text(encoding="utf-8", errors="replace"), headings, min_items)
        problems += found
        stats["files"] += 1
        stats["paths"] += counts["paths"]
        stats["commands"] += counts["commands"]
    return problems, stats


def context_state(cfg: dict) -> list:
    """(path, "missing" | "draft" | "reviewed") for each file `onboard` writes."""
    out = []
    for path in (cfg.get("onboard") or {}).values():
        file = ROOT / path
        if not file.is_file():
            out.append((path, "missing"))
        else:
            head = "\n".join(file.read_text(encoding="utf-8", errors="replace").splitlines()[:8])
            out.append((path, "draft" if STATUS_DRAFT.search(head) else "reviewed"))
    return out


def dirty_outside(allowed: list) -> list:
    """Uncommitted changes to anything except the allowed files (and the evidence folder). Empty when not a git repository."""
    if not (ROOT / ".git").exists():
        return []
    out = []
    for line in git_porcelain("-uall"):
        name = line[3:].split(" -> ")[-1].strip().strip('"')
        if name not in allowed and not name.startswith(".ai/evidence"):
            out.append(line)
    return out


def cmd_onboard(cfg: dict, args: argparse.Namespace) -> int:
    """An agent drafts a map of the repository and its conventions; the tool checks every claim it can; a person reviews."""
    if not cfg.get("onboard") or "onboard" not in cfg["agent"]["prompts"]:
        say(bad("`onboard` is for a repository adopted with `scaffolder adopt`: this project has no existing code to map."))
        return EXIT_USAGE
    targets = [cfg["onboard"][k] for k in ONBOARD_SECTIONS]
    if args.max_attempts < 1:
        die("--max-attempts must be at least 1")
    say(c("\n=== onboard: describe this repository ===", "1;35"))
    agent, problem = require_agent(cfg, args, "draft the repository context")
    if agent is None:
        return EXIT_HUMAN
    present = [t for t in targets if (ROOT / t).exists()]
    if present and not args.force:
        say(bad("These files already exist, so drafting again would overwrite your work:"))
        for t in present:
            say(f"  {t}")
        say("Edit them by hand, or pass --force to have the agent redraft them (your versions are kept in the evidence folder).")
        return EXIT_HUMAN
    if not (ROOT / ".git").exists():
        say(warn("  not a git repository: the agent's changes cannot be reviewed or reverted easily (run `git init` first)"))
    dirty = dirty_outside(targets)
    if dirty and not args.allow_dirty:
        say(bad("You have uncommitted changes:"))
        for line in dirty[:15]:
            say(f"  {line}")
        say("Commit or stash them first so you can see exactly what the agent changes (or pass --allow-dirty).")
        return EXIT_HUMAN

    run = Run("onboard")
    files = repo_files()
    guidance = existing_guidance(files)
    questions = run.dir / "QUESTIONS.md"
    integ = cfg["integrity"]
    values = {
        "architectureFile": targets[0], "conventionsFile": targets[1], "questionsFile": rel(questions),
        "tree": repo_tree([f for f in files if not f.startswith(".ai/")]),  # the overlay itself is not the project
        "stack": "\n".join(f"- {st['id'].split('.')[0]}: `{st['cwd']}/` (dependency manifest: {', '.join('`' + m + '`' for m in st.get('manifests', []))})"
                           for st in cfg["setup"]) or "(no install steps were detected)",
        "gates": "\n".join(f"- `{g['id']}`: `{g['cmd']}` (in `{g['cwd']}`)" for g in cfg["gates"]) or "(none)",
        "existingGuidance": "\n".join(f"- `{g}`" for g in guidance) or "(none)",
        "previous": ("Earlier drafts exist at " + ", ".join(f"`{t}`" for t in present) + ". Read them: keep what is still true and checkable, drop what is not, and do not discard a person's corrections.")
                    if present else "There is no earlier draft.",
        "rules": listing(".ai/rules/*.md"), "commands": ".ai/context/commands.md",
    }
    prompt = render_prompt(cfg["agent"]["prompts"]["onboard"], values)
    if args.dry_run:
        prompt_file = run.dir / "onboard.prompt.md"
        prompt_file.write_text(prompt, encoding="utf-8")
        say(ok("\nDry run: nothing was executed or written."))
        say(f"  agent command : {agent}" + (f"   (WARNING: {problem})" if problem else ""))
        handoff_note(cfg, agent)
        say(f"  would write   : {', '.join(targets)}")
        say(f"  prompt        : {rel(prompt_file)}  ({len(prompt.splitlines())} lines; {len(files)} files in the repository, {len(guidance)} existing guidance file(s) to fold in)")
        return EXIT_OK

    for t in present:  # --force: the earlier version is kept
        keep = run.dir / "previous" / t
        keep.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / t, keep)
    guard = integ["protected"] + integ["protectedWhileHealing"] + guidance
    before_snap, before_dirty = snapshot(guard), set(dirty_outside(targets))
    for attempt in range(1, args.max_attempts + 1):
        say(c(f"\n== agent: describing the repository (attempt {attempt}/{args.max_attempts}) ==", "1"))
        code = run_agent(cfg, agent, prompt, f"onboard-{attempt}", run.dir)
        blocker = agent_blocker(run.dir, f"onboard-{attempt}", code)
        if blocker:
            explain_blocker(agent, blocker)
            return EXIT_HUMAN
        if code != 0:
            say(warn(f"  the agent exited with {code}; validation below decides whether the draft is usable"))
        violations = changed(before_snap, snapshot(guard)) + sorted(set(dirty_outside(targets)) - before_dirty)
        if violations:
            say(bad("\nINTEGRITY VIOLATION: onboarding may only write the two files below, but these changed:"))
            for t in targets:
                say(f"  (allowed) {t}")
            for v in violations:
                say(bad(f"  - {v}"))
            say("Revert them (git checkout -- <path>; remove untracked files) and run again. Existing guidance files (AGENTS.md, CLAUDE.md, ...) are read, never edited.")
            (run.dir / "integrity-violation.md").write_text("\n".join(violations), encoding="utf-8")
            return EXIT_INTEGRITY
        if questions.exists() and questions.read_text(encoding="utf-8").strip():
            say(bad("\nThe agent could not describe the repository:"))
            say(questions.read_text(encoding="utf-8").strip())
            return EXIT_HUMAN
        for t in targets:  # what the agent wrote on this attempt, kept for review (and for replaying the checks offline)
            if (ROOT / t).is_file():
                kept = run.dir / f"attempt-{attempt}" / t
                kept.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(ROOT / t, kept)
        errors, stats = validate_onboard(cfg)
        if not errors:
            break
        say(warn(f"  the draft has {len(errors)} problem(s):"))
        for e in errors[:10]:
            say(f"    - {e}")
        if len(errors) > 10:
            say(f"    ... and {len(errors) - 10} more")
        if attempt == args.max_attempts:
            say(bad(f"\nThe draft is still not valid after {attempt} attempts. Fix {' and '.join(targets)} by hand; run `./<%sdlcDir%>/sdlc onboard --dry-run` to see the prompt."))
            return EXIT_FAIL
        prompt = render_prompt(cfg["agent"]["prompts"]["onboardFix"], {
            "attempt": attempt + 1, "maxAttempts": args.max_attempts, "errors": "\n".join(f"- {e}" for e in errors),
            "architectureFile": targets[0], "conventionsFile": targets[1], "questionsFile": rel(questions),
        })

    say(ok("\nDraft ready:"))
    for t in targets:
        say(f"  {t}")
    say(f"  checked against the repository: {stats['paths']} cited path(s) exist, {stats['commands']} command(s) are real, every item cites code")
    say(warn("This is a DRAFT written by an AI. The tool can check that what it cites exists, not that its description is right. Read it:"))
    say("  1. correct anything wrong or misleading; answer the open questions or leave them listed")
    say("  2. change each file's `Status: Draft ...` line to `Status: Reviewed`")
    say("  3. commit them: agents read these files before every task, so a wrong sentence misleads every one of them")
    return EXIT_OK


def cmd_sync(cfg: dict, args: argparse.Namespace) -> int:
    run = Run("sync")
    stale = stale_steps(cfg)
    if not stale:
        say(ok("dependencies are up to date"))
        return EXIT_OK
    say(dim("  installing dependencies: " + ", ".join(step["id"] for step in stale)))
    for step in stale:
        if not run_setup_step(step, run):
            return EXIT_FAIL
    say(ok("dependencies installed"))
    return EXIT_OK


def cmd_implement(cfg: dict, args: argparse.Namespace) -> int:
    """Spec in, verified code out: validate the spec, set up, baseline, run the agent, sync deps, verify + heal."""
    specs_dir = cfg["facts"]["specsDir"]
    spec_dir = find_spec(cfg, args.name)
    if spec_dir is None:
        existing = sorted(p.name for p in (ROOT / specs_dir).glob("FEAT-*") if not p.name.startswith(EXAMPLE_FEATURE))
        say(bad(f"No feature '{args.name}' under {specs_dir}/."))
        say("Create one with ./<%sdlcDir%>/sdlc new <slug>, write its prd.md and acceptance.json, then run this again."
            + (f"\nExisting features: {', '.join(existing)}" if existing else ""))
        return EXIT_HUMAN
    fid = spec_dir.name.split("-", 2)[0] + "-" + spec_dir.name.split("-", 2)[1]
    say(c(f"\n=== implement {fid} from {rel(spec_dir)}/ ===", "1;35"))

    # 0. the worked example is already built: running an agent on it would change nothing, so say so instead
    if fid == EXAMPLE_FEATURE:
        say(warn(f"{fid} is the worked example, and it is already built: its code and tests ship with this project."))
        say("There is nothing left for an agent to write, so `implement` would not change a single file.\n")
        say("  See it proven against the running system:  ./<%sdlcDir%>/sdlc verify")
        say("  Have an agent build something new:")
        say("    ./<%sdlcDir%>/sdlc new <slug>                 then write its prd.md and acceptance.json")
        say("    ./<%sdlcDir%>/sdlc spec requirements.pdf      or let an agent draft them from a requirements document")
        say("    ./<%sdlcDir%>/sdlc implement FEAT-001         the agent writes the code and the loop proves it")
        return EXIT_HUMAN

    # 1. the spec is the contract: it must be complete before an agent spends effort on it
    spec = next(sp for sp in load_specs(cfg) if sp["dir"] == spec_dir)
    good, errors = traceability(spec, set(cfg["runtime"]["targets"]))
    if not good:
        say(bad("The spec is not ready to implement:"))
        for e in errors:
            say(f"  - {e}")
        say("Finish prd.md and acceptance.json (skills: .ai/skills/write-prd, write-fact-checks), then run this again.")
        return EXIT_HUMAN
    say(ok(f"  spec ok: {len(spec['acs'])} acceptance criteria, {len(spec['checks'])} checks, every criterion covered"))

    # 2. an agent must be configured and installed
    agent, problem = require_agent(cfg, args, "write the code")
    if agent is None:
        return EXIT_HUMAN

    # 3. the agent's changes must be reviewable: start from a clean tree (only the spec may be uncommitted)
    if not (ROOT / ".git").exists():
        say(warn("  not a git repository: the agent's changes cannot be reviewed or reverted easily (run `git init` first)"))
    dirty = dirty_files(spec_dir)
    if dirty and not args.allow_dirty:
        say(bad("You have uncommitted changes outside this feature's spec:"))
        for line in dirty[:15]:
            say(f"  {line}")
        say("Commit or stash them first so you can review exactly what the agent changes (or pass --allow-dirty).")
        return EXIT_HUMAN

    run = Run(f"implement-{fid}")
    # 4. toolchain: install what is missing, so nobody runs `setup` by hand first
    if not args.dry_run and not ensure_installed(cfg, run):
        return EXIT_FAIL

    # 5. baseline: a red start would blame the agent for problems that were already there
    if not args.skip_baseline and not args.dry_run:
        say(c("\n== baseline (gates, before the agent starts) ==", "1"))
        base_args = argparse.Namespace(stage=None, only=None, keep_going=False)
        base, _ = run_verify(cfg, "baseline", base_args, with_facts=False)
        if not summarize(base, cfg):
            say(bad("The project is already failing before any change. Fix that first (or pass --skip-baseline)."))
            return EXIT_HUMAN

    # 6. the prompt: the spec itself plus how this repository works
    integ = cfg["integrity"]
    questions = run.dir / "QUESTIONS.md"
    stack = "\n".join(
        f"- {st['id'].split('.')[0]}: `{st['cwd']}/` (dependency manifest: {', '.join('`' + m + '`' for m in st.get('manifests', []))})"
        for st in cfg["setup"]
    )
    prompt = render_prompt(cfg["agent"]["prompts"]["implement"], {
        "feature": fid,
        "specDir": rel(spec_dir),
        "prd": (spec_dir / "prd.md").read_text(encoding="utf-8").strip(),
        "acceptance": (spec_dir / "acceptance.json").read_text(encoding="utf-8").strip(),
        "stack": stack or "(no components)",
        "gates": ", ".join(f"`{g['id']}`" for g in cfg["gates"]),
        "rules": listing(".ai/rules/*.md"),
        "skills": listing(".ai/skills/*/SKILL.md"),
        "protected": ", ".join(f"`{p}`" for p in integ["protected"] + integ["protectedWhileHealing"]),
        "questionsFile": rel(questions),
        "context": listing(".ai/context/*.md"),
    })
    for path, state in context_state(cfg):
        if state == "draft":
            say(warn(f"  note: {path} is still an unreviewed draft; the agent will use it, so read it soon (./<%sdlcDir%>/sdlc doctor)"))
    if args.dry_run:
        prompt_file = run.dir / "implement.prompt.md"
        prompt_file.write_text(prompt, encoding="utf-8")
        say(ok("\nDry run: nothing was executed."))
        say(f"  agent command : {agent}" + (f"   (WARNING: {problem})" if problem else ""))
        handoff_note(cfg, agent)
        say(f"  prompt        : {rel(prompt_file)}  ({len(prompt.splitlines())} lines, includes prd.md and acceptance.json)")
        return EXIT_OK

    # 7. the agent writes tests, code, dependencies, config and the contract
    say(c("\n== agent: implementing ==", "1"))
    before = snapshot(integ["protected"] + integ["protectedWhileHealing"])
    guarded_before = snapshot(integ["guarded"])
    head = git("rev-parse", "HEAD")
    work_before = work_fingerprint()
    code = run_agent(cfg, agent, prompt, f"implement-{fid}", run.dir)
    blocker = agent_blocker(run.dir, f"implement-{fid}", code)
    if blocker:
        explain_blocker(agent, blocker)
        return EXIT_HUMAN
    if code != 0:
        say(warn(f"  the agent exited with {code}; verification below decides whether the work is complete"))
    if git("rev-parse", "HEAD") != head:
        say(warn("  the agent made git commits: review them (git log), the tool never commits or pushes for you"))
    violations = changed(before, snapshot(integ["protected"] + integ["protectedWhileHealing"]))
    if violations:
        say(bad("\nINTEGRITY VIOLATION: the agent changed files that define what 'correct' means:"))
        for v in violations:
            say(bad(f"  - {v}"))
        say("The spec and the gate config belong to you, not the agent. Revert them (git checkout -- <path>) and run again.")
        (run.dir / "integrity-violation.md").write_text("\n".join(violations), encoding="utf-8")
        return EXIT_INTEGRITY
    guard_changes = changed(guarded_before, snapshot(integ["guarded"]))
    if guard_changes:
        say(warn("  the agent changed files that define what is checked (lint, types, tests, contract). Review them: " + ", ".join(guard_changes)))
    if questions.exists() and questions.read_text(encoding="utf-8").strip():
        say(bad("\nThe agent could not proceed without answers from you:"))
        say(questions.read_text(encoding="utf-8").strip())
        say("\nClarify the PRD / acceptance.json, then run this again.")
        return EXIT_HUMAN

    # 8. dependencies the agent added are installed even if it forgot to
    if not ensure_installed(cfg, run):
        return EXIT_FAIL

    # 9. prove it: verify, and heal with the same agent until green, stuck, or out of budget
    args.focus = fid
    result = cmd_loop(cfg, args)

    say(c("\n== what changed (nothing is committed) ==", "1"))
    say(git("status", "--short") or "(no changes)")
    if result == EXIT_OK:
        if work_before is not None and work_fingerprint() == work_before and git("rev-parse", "HEAD") == head:
            say(warn(f"\n{fid} passes, but this run changed no file: the code that was already here satisfies its spec, so there was nothing to write."))
            say("If you expected new code, the spec may only describe behaviour that already exists: compare prd.md with the code and add what is missing.")
        else:
            say(ok(f"\n{fid} is implemented and verified. Review with `git diff`, then commit and open a PR."))
        say(f"Evidence: .ai/evidence/latest/report.md")
    return result


def cmd_loop(cfg: dict, args: argparse.Namespace) -> int:
    max_iter = args.max or cfg["loop"]["maxIterations"]
    agent = resolve_agent(cfg, args)
    integ = cfg["integrity"]
    base_snap = snapshot(integ["protected"] + integ["protectedWhileHealing"])
    guarded_snap = snapshot(integ["guarded"])
    previous, same, history = None, 0, []
    for i in range(1, max_iter + 1):
        say(c(f"\n######## loop iteration {i}/{max_iter} ########", "1;36"))
        run, _ = run_verify(cfg, f"loop{i}", args)
        if summarize(run, cfg):
            guard_changes = changed(guarded_snap, snapshot(integ["guarded"]))
            if guard_changes:
                say(warn("  guarded verification inputs changed during the loop (review them): " + ", ".join(guard_changes)))
            return EXIT_OK
        fp = fingerprint(run)
        same = same + 1 if fp == previous else 1
        previous = fp
        history.append(", ".join(x["id"] for x in run.required_failures()))
        if same >= cfg["loop"]["noProgressLimit"]:
            say(bad(f"\nNo progress: the same failure repeated {same}x in a row. Stopping so it can be looked at by a human."))
            return EXIT_STUCK
        if i == max_iter:
            say(bad(f"\nBudget exhausted after {max_iter} iterations. Latest report: {rel(run.dir)}/report.md"))
            return EXIT_FAIL
        prompt = render_prompt(cfg["agent"]["prompts"]["heal"], {
            "iteration": i, "maxIterations": max_iter, "failures": failures_markdown(run),
            "previousAttempts": "\n".join(f"- iteration {n + 1}: {h}" for n, h in enumerate(history[:-1])) or "none",
            "feature": getattr(args, "focus", None) or args.feature or "(all)", "changedFiles": git("status", "--short") or "(unknown)",
            "report": f"{rel(run.dir)}/report.md", "context": listing(".ai/context/*.md"),
        })
        if not agent:
            path = run.dir / f"heal-{i}.prompt.md"
            path.write_text(prompt, encoding="utf-8")
            say(warn(f"\nNo agent configured. Fix the failures above (prompt for your AI assistant: {rel(path)})."))
            if sys.stdin.isatty():
                try:
                    input("Press Enter to re-verify (Ctrl-C to stop)... ")
                except (EOFError, KeyboardInterrupt):
                    return EXIT_HUMAN
            else:
                return EXIT_HUMAN
        else:
            code = run_agent(cfg, agent, prompt, f"heal-{i}", run.dir)
            blocker = agent_blocker(run.dir, f"heal-{i}", code)
            if blocker:
                explain_blocker(agent, blocker)
                return EXIT_HUMAN
            ensure_installed(cfg, run)  # dependencies the agent added while healing
        now = snapshot(integ["protected"] + integ["protectedWhileHealing"])
        violations = changed(base_snap, now)
        if violations:
            say(bad("\nINTEGRITY VIOLATION: files that define what 'correct' means were modified while healing:"))
            for v in violations:
                say(bad(f"  - {v}"))
            say("Healing must fix the code, not the checks. Revert these changes (git checkout -- <path>) and re-run.")
            (run.dir / "integrity-violation.md").write_text("\n".join(violations), encoding="utf-8")
            return EXIT_INTEGRITY
    return EXIT_FAIL


# --------------------------------------------------------------------------- commands


def cmd_setup(cfg: dict, args: argparse.Namespace) -> int:
    run = Run("setup")
    needed = {step["id"] for step in stale_steps(cfg)}
    for step in cfg["setup"]:
        if step.get("trustExisting") and step["id"] not in needed:
            # an adopted project's own environment: reinstalling over it (npm ci deletes node_modules) is not what "set up" should do
            say(dim(f"  {step['label']}: already installed, used as it is"))
            continue
        if not run_setup_step(step, run):
            return EXIT_FAIL
    say(ok("setup complete"))
    return EXIT_OK


def gate_results(run: Run) -> dict:
    """What each gate did in this run, as recorded in the baseline: the exit code decides, not the (possibly softened) status."""
    return {
        i["id"]: {"label": i["label"], "passed": i["exitCode"] == 0, "exitCode": i["exitCode"]}
        for i in run.items if i["kind"] == "gate"
    }


def cmd_baseline(cfg: dict, args: argparse.Namespace) -> int:
    """Record which gates pass today (an adopted project's starting line), or lock in gates that have started to pass."""
    ratchet = ratchet_config(cfg)
    if not ratchet:
        say(bad("This project has no baseline: `baseline` is for a repository adopted with `scaffolder adopt`."))
        return EXIT_USAGE
    path = ROOT / ratchet["baseline"]
    existing = load_baseline(cfg)
    if args.tighten and args.force:
        die("use either --tighten or --force, not both")
    if existing is not None and not (args.tighten or args.force):
        say(warn(f"{rel(path)} already exists."))
        say("  ./<%sdlcDir%>/sdlc baseline --tighten   lock in gates that pass now (it never loosens anything)")
        say("  ./<%sdlcDir%>/sdlc baseline --force     record everything again from scratch: every current failure becomes the new normal")
        return EXIT_HUMAN
    if args.tighten and existing is None:
        say(bad("Nothing to tighten: there is no baseline yet. Run ./<%sdlcDir%>/sdlc baseline first."))
        return EXIT_HUMAN

    run = Run("baseline")
    if not ensure_installed(cfg, run):
        return EXIT_FAIL
    if secrets_baseline_path(cfg) is not None and not args.tighten:
        n = write_secrets_baseline(cfg)
        if n:
            say(warn(f"  {n} possible secret(s) are already in the repository: recorded as known so they do not block you, but they are still there. Review them and rotate anything real."))
    say(c("\n== baseline: running every gate once ==", "1"))
    every = argparse.Namespace(stage=None, only=None, keep_going=True)
    result, _ = run_verify(cfg, "baseline", every, with_facts=False, use_baseline=bool(args.tighten))
    now = gate_results(result)

    if args.tighten:
        before = existing["gates"]
        regressions = sorted(g for g, was in before.items() if was.get("passed") and g in now and not now[g]["passed"])
        if regressions:
            say(bad(f"\nNot tightened: these gates passed at the baseline and fail now: {', '.join(regressions)}. Fix them first."))
            return EXIT_FAIL
        promoted = sorted(g for g, was in before.items() if not was.get("passed") and g in now and now[g]["passed"])
        added = sorted(g for g in now if g not in before)
        for g in promoted + added:
            before[g] = now[g]
        if not promoted and not added:
            say(ok("\nNothing to tighten: no gate that failed at the baseline passes yet."))
            return EXIT_OK
        existing["recorded"] = datetime.datetime.now().isoformat(timespec="seconds")
        path.write_text(json.dumps(existing, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        say(ok(f"\nTightened {rel(path)}: " + "; ".join(x for x in (
            f"now locked as passing: {', '.join(promoted)}" if promoted else "", f"new gates recorded: {', '.join(added)}" if added else "") if x)))
        say("Commit it.")
        return EXIT_OK

    data = {"version": 1, "recorded": datetime.datetime.now().isoformat(timespec="seconds"),
            "git": git_info().get("sha", ""), "gates": now}
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    passing = sorted(g for g, r in now.items() if r["passed"])
    failing = sorted(g for g, r in now.items() if not r["passed"])
    say("")
    say(ok(f"Baseline recorded in {rel(path)}: {len(passing)} gate(s) pass, {len(failing)} fail."))
    if failing:
        say(warn("These fail today. They are recorded as known: they will show as warnings and will not block, until you fix them and run `baseline --tighten`:"))
        for g in failing:
            say(f"  - {g}  ({now[g]['label']})")
    say(f"What passes now may not fail from here on. Commit .ai/ including {rel(path)}, then use ./<%sdlcDir%>/sdlc verify.")
    return EXIT_OK


def cmd_doctor(cfg: dict, args: argparse.Namespace) -> int:
    needed = {"git": True}
    if any(s["toolchain"] == "node" for s in cfg["setup"]):
        needed.update({"node": True, "npm": True})
    if cfg["runtime"]["mode"] == "docker":
        needed["docker"] = True
    for tool in cfg.get("tools", []):  # an adopted project says which programs its gates run (node, pnpm, uv, make, ...)
        needed[tool] = True
    for step in cfg["setup"]:
        for tool in step.get("tools", []):
            needed[tool] = True
    bad_count = 0
    say(f"  {ok('ok  ')}  {'system':12} {describe_platform()}")
    # the interpreter running this tool is the proof that Python works; `python3` on PATH may be a Windows Store stub
    say(f"  {ok('ok  ')}  {'python':12} {sys.executable} (Python {sys.version_info[0]}.{sys.version_info[1]}, runs this tool)")
    for tool, required in needed.items():
        path = shutil.which(tool)
        version = ""
        if path:
            with contextlib.suppress(Exception):
                # the resolved path, not the bare name: on Windows `npm` is npm.cmd, which only the PATHEXT-aware lookup finds
                version = subprocess.run([path, "--version"], capture_output=True, encoding="utf-8", errors="replace", timeout=10).stdout.strip().splitlines()[0]
        say(f"  {ok('ok  ') if path else bad('MISS')}  {tool:12} {version}")
        bad_count += 0 if path else 1
    for step in cfg["setup"]:
        minimum = step.get("minPython")
        if not minimum:
            continue
        path, ver = find_python(minimum)
        name = f"python>={minimum}"
        if path:
            say(f"  {ok('ok  ')}  {name:12} {path} (Python {ver[0]}.{ver[1]}) for {step['id']}")
        else:
            bad_count += 1
            shown = f"{ver[0]}.{ver[1]}" if ver else "none"
            say(f"  {bad('MISS')}  {name:12} {step['label']} needs Python >= {minimum}; the newest found is {shown}")
            for line in install_hints(minimum):
                say(f"        {line.strip()}")
    if ratchet_config(cfg):
        if load_baseline(cfg) is None:
            say(f"  {warn('note')}  {'baseline':12} not recorded yet: run ./<%sdlcDir%>/sdlc baseline once (after setup) and commit .ai/baseline.json")
        else:
            say(f"  {ok('ok  ')}  {'baseline':12} {ratchet_config(cfg)['baseline']}")
    for path, state in context_state(cfg):
        if state == "missing":
            say(f"  {warn('note')}  {'context':12} {path}: not drafted yet (./<%sdlcDir%>/sdlc onboard)")
        elif state == "draft":
            say(f"  {warn('note')}  {'context':12} {path}: still a draft. Read it, correct it, then change its Status line to Reviewed")
        else:
            say(f"  {ok('ok  ')}  {'context':12} {path}")
    agent, source = current_agent(cfg)
    if not agent:
        say(f"  {warn('note')}  {'agent':12} none configured: `spec` and `implement` will ask you to choose one (./<%sdlcDir%>/sdlc agent)")
    else:
        problem = agent_problem(agent, cfg)
        say(f"  {warn('note') if problem else ok('ok  ')}  {'agent':12} {agent_name(cfg, agent)}" + (f"   ({problem})" if problem else f"   ({source})"))
    rows = agent_table(cfg)
    here = [row["id"] for row in rows if row["path"] and not row["command"].startswith(HANDOFF)]
    apps = [row["id"] for row in rows if row["path"] and row["command"].startswith(HANDOFF)]
    if here:
        say(f"  {ok('ok  ')}  {'agents':12} installed here: {', '.join(here)}   (choose with ./<%sdlcDir%>/sdlc agent)")
    else:
        names = ", ".join(row["id"] for row in rows if not row["command"].startswith(HANDOFF))
        say(f"  {warn('note')}  {'agents':12} none of {names} is installed: ./<%sdlcDir%>/sdlc agent shows how to install one")
    if apps:
        say(f"  {ok('ok  ')}  {'desktop apps':12} you can drive: {', '.join(apps)}   (the tool opens one and waits for you; see ./<%sdlcDir%>/sdlc agent)")
    say(f"  {ok('ok  ')}  {'pdf reader':12} {pdf_reader_name()}   (for `spec`; .docx, .md and .txt need nothing)")
    say("")
    say(ok("toolchain ready") if not bad_count else bad(f"{bad_count} required tool(s) missing"))
    return EXIT_OK if not bad_count else EXIT_FAIL


def cmd_gates(cfg: dict, args: argparse.Namespace) -> int:
