def next_feature_id(cfg: dict) -> str:
    nums = [int(m.group(1)) for p in (ROOT / cfg["facts"]["specsDir"]).glob("FEAT-*") if (m := re.match(r"FEAT-(\d+)", p.name))]
    return f"FEAT-{(max(nums) + 1) if nums else 1:03d}"


def slugify(s: str) -> str:
    return re.sub(r"-{2,}", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-") or "feature"


def cmd_new(cfg: dict, args: argparse.Namespace) -> int:
    base = ROOT / cfg["facts"]["specsDir"]
    slug, title = slugify(args.slug), args.title or args.slug.replace("-", " ").title()
    existing = [p for p in base.glob("FEAT-*") if p.name.split("-", 2)[2] == slug]
    if existing:
        say(f"spec already exists: {rel(existing[0])}")
        return EXIT_OK
    fid = next_feature_id(cfg)
    dest = base / f"{fid}-{slug}"
    shutil.copytree(base / "_template", dest)
    for f in dest.iterdir():
        f.write_text(f.read_text().replace("{{ID}}", fid).replace("{{TITLE}}", title).replace("{{SLUG}}", slug))
    say(ok(f"created {rel(dest)}/  (edit prd.md + acceptance.json, or run: ./scripts/sdlc feature {fid})"))
    return EXIT_OK


def find_spec(cfg: dict, ref: str) -> Path | None:
    base = ROOT / cfg["facts"]["specsDir"]
    for p in sorted(base.glob("FEAT-*")):
        if ref in (p.name, p.name.split("-", 2)[0] + "-" + p.name.split("-", 2)[1], p.name.split("-", 2)[2]):
            return p
    return None


def cmd_feature(cfg: dict, args: argparse.Namespace) -> int:
    agent = args.agent if args.agent is not None else os.environ.get("SDLC_AGENT_CMD", cfg["agent"]["command"])
    say(c(f"\n=== PRD: {args.name} ===", "1;35"))
    spec = find_spec(cfg, args.name)
    if spec is None:
        if re.fullmatch(r"FEAT-\d+", args.name):
            die(f"no spec folder for {args.name} under {cfg['facts']['specsDir']}/")
        cmd_new(cfg, argparse.Namespace(slug=args.name, title=None))
        spec = find_spec(cfg, slugify(args.name))
    assert spec is not None
    fid = spec.name.split("-", 2)[0] + "-" + spec.name.split("-", 2)[1]
    prd_text = (spec / "prd.md").read_text()
    if "TODO(prd)" in prd_text:
        if agent and args.brief:
            values = {"feature": fid, "specDir": rel(spec), "brief": args.brief}
            run_agent(cfg, agent, render_prompt(cfg["agent"]["prompts"]["prd"], values), f"prd-{fid}", spec)
        else:
            say(warn(f"PRD is a stub: finish {rel(spec)}/prd.md and acceptance.json (skill: .ai/skills/write-prd), then re-run."))
            say(dim("Tip: configure sdlc.agent.command and pass --brief \"...\" to have the agent draft it."))
            return EXIT_HUMAN
    if args.skip_code:
        say(dim("\n=== CODE: skipped (--skip-code) ==="))
        say(c(f"\n=== TEST: {fid} ===", "1;35"))
        args.focus = fid  # the loop verifies EVERYTHING (regressions included); the feature only focuses the agent prompt
        code = cmd_loop(cfg, args)
    else:
        say(c(f"\n=== CODE + TEST: {fid} ===", "1;35"))
        args.name = fid
        code = cmd_implement(cfg, args)
    if code != EXIT_OK or not args.deploy:
        return code
    say(c(f"\n=== DEPLOY: {args.deploy} ===", "1;35"))
    return cmd_deploy(cfg, argparse.Namespace(environment=args.deploy, tag=None))


def cmd_deploy(cfg: dict, args: argparse.Namespace) -> int:
    envs = {e["name"]: e for e in cfg["deploy"]["environments"]}
    if args.environment not in envs:
        die(f"unknown environment '{args.environment}' (choose: {', '.join(envs)})")
    tag = args.tag or f"sha-{git('rev-parse', '--short=12', 'HEAD') or 'local'}"
    script = ROOT / cfg["deploy"]["script"]
    if not script.exists():
        die("deployment is not configured (cd.enabled=false at generation time)")
    say(f"deploying {tag} -> {args.environment} (target: {cfg['deploy']['target']})")
    code = subprocess.call([str(script), args.environment, tag], cwd=str(ROOT))
    if code != 0:
        say(bad("deploy script failed; nothing was verified"))
        return EXIT_FAIL
    if cfg["deploy"]["target"] == "none":
        say(warn("deploy target is 'none' (placeholder): nothing was deployed, so there is no live URL to verify."))
        return EXIT_OK
    web_url = envs[args.environment]["url"]
    run = Run(f"deploy-{args.environment}")
    say(c("\n== post-deploy facts ==", "1"))
    ns = argparse.Namespace(feature=None, runtime="none", base_url=[f"web={web_url}"], no_runtime=True, provides=[])
    specs = run_facts(cfg, run, ns)
    run.finish(cfg, specs)
    return EXIT_OK if summarize(run, cfg) else EXIT_FAIL


SECRET_PATTERNS = [
    ("AWS access key id", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("private key block", re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b")),
    ("Slack token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}")),
    ("Anthropic/OpenAI style API key", re.compile(r"\b(?:sk-ant-|sk-)[A-Za-z0-9_-]{24,}")),
    ("hard-coded credential", re.compile(r"""(?i)\b(?:api[_-]?key|secret|token|passwd|password)\b['"]?\s*[:=]\s*['"](?![$<{%])[^'"\s]{12,}['"]""")),
]
SECRET_SKIP_DIRS = {".git", "node_modules", ".venv", ".next", "__pycache__", ".ai/evidence"}
SECRET_SKIP_FILES = {".env.example", "package-lock.json", "docker-compose.yml"}
# Fake credentials are normal in tests and specs, so the generic keyword heuristic skips them.
# High-confidence formats (cloud keys, tokens, private keys) are still caught everywhere.
FIXTURE_PATH = re.compile(r"(^|/)(tests|__tests__)/|^\.ai/specs/")
SECRET_BAD_NAMES = re.compile(r"(^|/)(\.env|id_rsa|id_ed25519|.*\.pem|.*\.p12|.*\.pfx)$")


def cmd_secrets(cfg: dict, args: argparse.Namespace) -> int:
    listed = git("ls-files", "-co", "--exclude-standard")
    if listed:
        files = [ROOT / f for f in listed.splitlines()]
    else:
        files = [p for p in ROOT.rglob("*") if p.is_file() and not (set(p.relative_to(ROOT).parts) & SECRET_SKIP_DIRS)]
    findings = []
    for f in files:
        r = rel(f)
        if not f.is_file() or any(r.startswith(d + "/") for d in SECRET_SKIP_DIRS) or f.name in SECRET_SKIP_FILES:
            continue
        if SECRET_BAD_NAMES.search(r):
            findings.append(f"{r}: file that should never be committed")
            continue
        if f.suffix in (".md", ".png", ".jpg", ".ico", ".zip", ".gz", ".woff2") or f.stat().st_size > 1_000_000:
            continue
        try:
            text = f.read_text(errors="strict")
        except (UnicodeDecodeError, OSError):
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if "sdlc:allow-secret" in line:
                continue
            for name, rx in SECRET_PATTERNS:
                if name == "hard-coded credential" and FIXTURE_PATH.search(r):
                    continue
                if rx.search(line):
                    findings.append(f"{r}:{n}: {name}")
    if findings:
        say(bad(f"{len(findings)} possible secret(s):"))
        for x in findings[:50]:
            say(f"  - {x}")
        say("Remove them and rotate anything real. Add '# sdlc:allow-secret' to a line only for a deliberate fake.")
        return EXIT_FAIL
    say(ok("no secrets found"))
    return EXIT_OK


def cmd_up(cfg: dict, args: argparse.Namespace) -> int:
    run = Run("up")
    mode = cfg["runtime"]["mode"]
    if mode != "docker":
        die("`up` is for runtime mode 'docker'; for local mode run the services from .ai/sdlc.json yourself")
    code = run_shell(cfg["runtime"]["docker"]["up"], ROOT, run.logs / "up.log", env=os.environ.copy(), timeout=1500)
    say(ok("stack is up") if code == 0 else bad(tail_lines(run.logs / "up.log", 40)))
    return EXIT_OK if code == 0 else EXIT_FAIL


def cmd_down(cfg: dict, args: argparse.Namespace) -> int:
    run = Run("down")
    code = run_shell(cfg["runtime"]["docker"]["down"], ROOT, run.logs / "down.log", env=os.environ.copy(), timeout=300)
    return EXIT_OK if code == 0 else EXIT_FAIL


def cmd_report(cfg: dict, args: argparse.Namespace) -> int:
    path = EVIDENCE / "latest" / "report.md"
    if not path.exists():
        die("no report yet: run ./scripts/sdlc verify", EXIT_FAIL)
    say(path.read_text())
    return EXIT_OK


# --------------------------------------------------------------------------- entry


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="sdlc", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    def common(sp: argparse.ArgumentParser, *, facts: bool = True) -> None:
        sp.add_argument("--stage", help="only this stage")
        sp.add_argument("--only", action="append", help="only this gate id (repeatable)")
        sp.add_argument("--keep-going", action="store_true", help="do not stop at the first failing stage")
        sp.add_argument("--label", help="label for the evidence folder")
        if facts:
            facts_opts(sp)

    def facts_opts(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--feature", help="only this feature (FEAT-001 or its slug)")
        sp.add_argument("--runtime", choices=["docker", "local", "none"], help="override runtime mode")
        sp.add_argument("--no-runtime", action="store_true", help="do not start anything; probe already-running URLs")
        sp.add_argument("--base-url", action="append", help="target=URL override, e.g. web=https://staging.example.com")
        sp.add_argument("--provides", action="append", help="capability available without a runtime (e.g. db)")

    sub.add_parser("setup")
    sub.add_parser("doctor")
    common(sub.add_parser("gates"), facts=False)
    f = sub.add_parser("facts")
    facts_opts(f)
    f.add_argument("--label")
    common(sub.add_parser("verify"))
    lp = sub.add_parser("loop")
    common(lp)
    lp.add_argument("--max", type=int, help="override max iterations")
    lp.add_argument("--agent", help="agent command (reads the prompt on stdin); '' = human in the loop")
    ft = sub.add_parser("feature")
    ft.add_argument("name", help="FEAT-001, a slug, or a new feature name")
    ft.add_argument("--brief", help="one-paragraph description for the agent to draft the PRD from")
    ft.add_argument("--skip-code", action="store_true")
    ft.add_argument("--deploy", metavar="ENV", help="deploy to ENV after verification passes")
    ft.add_argument("--max", type=int)
    ft.add_argument("--agent")
    ft.add_argument("--allow-dirty", action="store_true")
    ft.add_argument("--skip-baseline", action="store_true")
    common(ft, facts=False)
    im = sub.add_parser("implement")
    im.add_argument("name", help="FEAT-001 or its slug; its prd.md and acceptance.json must be finished")
    im.add_argument("--agent", help="agent command (reads the prompt on stdin); overrides the configured one")
    im.add_argument("--max", type=int, help="override max heal iterations")
    im.add_argument("--allow-dirty", action="store_true", help="proceed with uncommitted changes outside the spec")
    im.add_argument("--skip-baseline", action="store_true", help="do not run the gates before the agent starts")
    im.add_argument("--dry-run", action="store_true", help="validate, write the prompt, print the agent command; run nothing")
    common(im)
    sp = sub.add_parser("spec")
    sp.add_argument("source", help="requirements document: .pdf, .docx, .md or .txt")
    sp.add_argument("--name", help="feature slug (default: the file name)")
    sp.add_argument("--focus", help="cover only this part of the document, e.g. 'the login flow (section 3)'")
    sp.add_argument("--agent", help="agent command (reads the prompt on stdin); overrides the configured one")
    sp.add_argument("--allow-dirty", action="store_true", help="proceed with uncommitted changes")
    sp.add_argument("--dry-run", action="store_true", help="extract the text, write the prompt, print the agent command; run nothing")
    sp.add_argument("--max-attempts", type=int, default=3, help="how many times the agent may fix an invalid draft")
    sub.add_parser("sync")
    nw = sub.add_parser("new")
    nw.add_argument("slug")
    nw.add_argument("--title")
    dp = sub.add_parser("deploy")
    dp.add_argument("environment")
    dp.add_argument("--tag")
    sub.add_parser("secrets")
    sub.add_parser("up")
    sub.add_parser("down")
    sub.add_parser("report")
    return p


COMMANDS = {
    "setup": cmd_setup, "doctor": cmd_doctor, "gates": cmd_gates, "facts": cmd_facts, "verify": cmd_verify, "loop": cmd_loop,
    "feature": cmd_feature, "spec": cmd_spec, "implement": cmd_implement, "sync": cmd_sync, "new": cmd_new, "deploy": cmd_deploy, "secrets": cmd_secrets, "up": cmd_up, "down": cmd_down, "report": cmd_report,
}


def main(argv: list | None = None) -> int:
    args = build_parser().parse_args(argv)
    cfg = load_config()
    for name, default in (("runtime", None), ("no_runtime", False), ("base_url", None), ("provides", None), ("feature", None),
                           ("allow_dirty", False), ("skip_baseline", False), ("dry_run", False), ("agent", None), ("max", None)):
        if not hasattr(args, name):
            setattr(args, name, default)
    try:
        return COMMANDS[args.command](cfg, args)
    except KeyboardInterrupt:
        say(warn("\ninterrupted"))
        return EXIT_HUMAN


if __name__ == "__main__":
    sys.exit(main())
