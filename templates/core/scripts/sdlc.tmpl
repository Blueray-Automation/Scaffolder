#!/usr/bin/env bash
# Entry point for the SDLC loop tooling. All logic lives in scripts/sdlc.py (stdlib-only Python 3.9+).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 (3.9+) is required to run the SDLC loop tooling" >&2
  exit 127
fi
exec python3 "$DIR/sdlc.py" "$@"
