"""Operational endpoints. Unversioned on purpose: orchestrators depend on them."""

from fastapi import APIRouter, Response, status

<%#hasDb%>
from app.db.session import check_database
<%/hasDb%>
from app.schemas.health import HealthResponse, ReadyResponse

router = APIRouter(tags=["system"])


@router.get("/health", response_model=HealthResponse, summary="Liveness")
async def health() -> HealthResponse:
    """The process is up. Touches no dependency, so it never flaps."""
    return HealthResponse(status="ok")


@router.get(
    "/ready",
    response_model=ReadyResponse,
    responses={503: {"model": ReadyResponse}},
    summary="Readiness",
)
async def ready(response: Response) -> ReadyResponse:
    """The service can do useful work: its dependencies are reachable."""
<%#hasDb%>
    database = await check_database()
    if database is False:
        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE
        return ReadyResponse(status="degraded", database="down")
    return ReadyResponse(status="ok", database="disabled" if database is None else "up")
<%/hasDb%>
<%^hasDb%>
    response.status_code = status.HTTP_200_OK
    return ReadyResponse(status="ok", database="disabled")
<%/hasDb%>
