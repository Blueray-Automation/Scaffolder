import pytest
from fastapi.testclient import TestClient


def test_hello_greets_the_world_by_default(client: TestClient) -> None:
    response = client.get("/api/v1/hello")

    assert response.status_code == 200
    assert response.json() == {"message": "Hello, World!"}


def test_hello_greets_the_given_name(client: TestClient) -> None:
    response = client.get("/api/v1/hello", params={"name": "Ada"})

    assert response.json() == {"message": "Hello, Ada!"}


def test_hello_accepts_unicode_names(client: TestClient) -> None:
    response = client.get("/api/v1/hello", params={"name": "Zoë 你好"})

    assert response.json() == {"message": "Hello, Zoë 你好!"}


def test_hello_accepts_a_name_of_exactly_50_characters(client: TestClient) -> None:
    response = client.get("/api/v1/hello", params={"name": "a" * 50})

    assert response.status_code == 200


@pytest.mark.parametrize("name", ["a" * 51, ""], ids=["too-long", "empty"])
def test_hello_rejects_invalid_names_with_422(client: TestClient, name: str) -> None:
    response = client.get("/api/v1/hello", params={"name": name})

    assert response.status_code == 422
