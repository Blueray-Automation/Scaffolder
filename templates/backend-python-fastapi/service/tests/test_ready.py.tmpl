import pytest
from fastapi.testclient import TestClient


def test_ready_reports_database_disabled_when_not_configured(client: TestClient) -> None:
    response = client.get("/ready")

    assert response.status_code == 200
    assert response.json() == {"status": "ok", "database": "disabled"}


def test_ready_returns_200_when_database_is_up(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    async def database_up() -> bool:
        return True

    monkeypatch.setattr("app.api.health.check_database", database_up)

    response = client.get("/ready")

    assert response.status_code == 200
    assert response.json() == {"status": "ok", "database": "up"}


def test_ready_returns_503_when_database_is_down(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    async def database_down() -> bool:
        return False

    monkeypatch.setattr("app.api.health.check_database", database_down)

    response = client.get("/ready")

    assert response.status_code == 503
    assert response.json() == {"status": "degraded", "database": "down"}
