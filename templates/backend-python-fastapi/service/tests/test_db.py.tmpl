from typing import Any

import pytest

from app.db import session


class _Connection:
    async def __aenter__(self) -> "_Connection":
        return self

    async def __aexit__(self, *_exc: object) -> None:
        return None

    async def execute(self, _statement: Any) -> None:
        return None


class _HealthyEngine:
    disposed = False

    def connect(self) -> _Connection:
        return _Connection()

    async def dispose(self) -> None:
        self.disposed = True


class _BrokenEngine:
    def connect(self) -> _Connection:
        raise OSError("connection refused")


async def test_check_database_is_none_when_no_url_is_configured() -> None:
    assert await session.check_database() is None


async def test_check_database_is_true_when_a_query_succeeds(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setattr(session, "get_engine", lambda: _HealthyEngine())

    assert await session.check_database() is True


async def test_check_database_is_false_instead_of_raising_when_unreachable(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setattr(session, "get_engine", lambda: _BrokenEngine())

    assert await session.check_database() is False


def test_get_engine_is_created_once_from_the_configured_url(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    from app.core.config import get_settings

    monkeypatch.setenv("DATABASE_URL", "postgresql+asyncpg://u:p@localhost:5432/db")
    get_settings.cache_clear()
    monkeypatch.setattr(session, "_engine", None)

    first = session.get_engine()
    second = session.get_engine()

    assert first is not None
    assert first is second


async def test_dispose_engine_releases_the_shared_engine(monkeypatch: pytest.MonkeyPatch) -> None:
    engine = _HealthyEngine()
    monkeypatch.setattr(session, "_engine", engine)

    await session.dispose_engine()

    assert engine.disposed is True
    assert session._engine is None
