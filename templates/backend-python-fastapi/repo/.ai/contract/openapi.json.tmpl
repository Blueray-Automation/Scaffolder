{
  "contract": 1,
  "paths": {
    "/api/v1/hello": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "default": "World",
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "hello"
        ]
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    }
  },
  "schemas": {
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "HealthResponse": {
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "HelloResponse": {
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ReadyResponse": {
      "properties": {
        "database": {
          "enum": [
            "up",
            "down",
            "disabled"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "degraded"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "database"
      ],
      "type": "object"
    },
    "ValidationError": {
      "properties": {
        "ctx": {
          "type": "object"
        },
        "input": {},
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        "msg": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "type": "object"
    }
  }
}
